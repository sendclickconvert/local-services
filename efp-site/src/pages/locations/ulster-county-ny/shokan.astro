---
// Shokan, Ulster County — individual static location page
import LocationLayout from '../../../layouts/LocationLayout.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import Breadcrumb from '../../../components/ui/Breadcrumb.astro';
import FAQSection from '../../../components/ui/FAQSection.astro';
import KeyTakeaway from '../../../components/ui/KeyTakeaway.astro';
import AuthorByline from '../../../components/ui/AuthorByline.astro';
import EstimateForm from '../../../components/forms/EstimateForm.astro';
import ServiceSchema from '../../../components/schema/ServiceSchema.astro';
import FAQSchema from '../../../components/schema/FAQSchema.astro';
import { services } from '../../../data/services';

const title       = "Forestry Consulting — Shokan, NY | EFP";
const description = "Certified forestry consulting in Shokan, Ulster County. 480-a Forest Tax Law, timber harvesting, and woodlot management on the Route 28 corridor. Henry Kowalec, 30+ years experience. Call (845) 754-8242.";
const canonicalUrl = "https://eforestproducts.com/locations/ulster-county-ny/shokan";

const crumbs = [
  { label: "Home",      href: "/" },
  { label: "Locations", href: "/locations" },
  { label: "Ulster County, NY", href: "/locations/ulster-county-ny" },
  { label: "Shokan", href: "/locations/ulster-county-ny/shokan" },
];

const faqs = [
  { question: "Do you provide forestry consulting near Shokan, NY?", answer: "Yes. Environmental Forest Products serves private landowners in Shokan and throughout Ulster County. Henry Kowalec has 30+ years of hands-on forestry experience in the Ashokan Reservoir watershed area and provides on-site assessments for all service inquiries. Call (845) 754-8242." },
  { question: "Are there NYC DEP watershed regulations that affect forestry near Shokan?", answer: "Properties in the Town of Olive near the Ashokan Reservoir and its tributary drainages may be subject to NYC DEP regulations. Henry Kowalec has worked on properties in this zone and understands what those regulations require for specific parcels — this is a critical factor that influences what forestry operations are permissible and how management plans must be structured." },
  { question: "Does my Shokan property qualify for 480-a Forest Tax Law enrollment?", answer: "New York's 480-a program generally requires 50 or more contiguous acres of qualifying woodland. Town of Olive properties with sufficient forested acreage and appropriate species composition are strong candidates. An on-site assessment is the only way to confirm eligibility for a specific parcel — call (845) 754-8242 to schedule one." },
  { question: "Can you appraise the timber value on my Shokan property?", answer: "Yes. A timber appraisal identifies species, diameter, volume, and current stumpage market value. The mixed hardwood stands in the Shokan area — red oak, red maple, black birch — hold timber value that most landowners have not had independently assessed. An independent appraisal establishes a baseline before any buyer negotiation begins." },
  { question: "Do you handle land clearing near Shokan?", answer: "Yes. Land clearing for residential and commercial site preparation is available throughout Ulster County. Every clearing project starts with a timber assessment — if merchantable trees are present, EFP recovers that value before clearing begins, reducing the net project cost." },
];
---

<LocationLayout title={title} description={description} canonicalUrl={canonicalUrl}>
  <ServiceSchema
    pageType="location"
    serviceName="Forestry Consulting — Shokan, Ulster County"
    description={description}
    url={canonicalUrl}
    areaServed={["Shokan, NY", "Ulster County, NY"]}
    crumbs={crumbs}
  />
  <FAQSchema items={faqs} />
  <Breadcrumb crumbs={crumbs} />

  <PageHero
    title="Forestry Consulting in Shokan, NY"
    subtitle="Serving Shokan and the Route 28 corridor — certified forestry near the Ashokan Reservoir"
  />

  <article class="max-w-4xl mx-auto my-8 sm:my-10 px-8 sm:px-12 py-10 bg-white rounded-2xl shadow-md ring-1 ring-gray-200">

    <KeyTakeaway
      text="Environmental Forest Products provides certified forestry consulting for Shokan area landowners. Henry Kowalec brings 30+ years of Ulster County experience — including direct familiarity with the Ashokan watershed and NYC DEP regulations that affect forestry in the Town of Olive."
    />

    <AuthorByline />

    <h2 class="text-2xl font-bold text-[#1a3c1a] mt-10 mb-4">Shokan's Woodland and Forest Terrain</h2>
    <p class="text-gray-700 leading-relaxed mb-4">
      Shokan is a hamlet in the Town of Olive along the Route 28 corridor, positioned at the gateway to the central Catskills and the Ashokan Reservoir watershed. The forest here is mixed hardwood — red oak, red maple, black birch, and hemlock in the drainages — on transitional terrain between the mid-county valley and the Catskill foothills rising to the west. Private parcels in this area are often substantially forested with timber value that has not been independently assessed.
    </p>
    <p class="text-gray-700 leading-relaxed mb-4">
      The Ashokan Reservoir watershed overlay means that forestry operations on properties near the reservoir and its tributaries are subject to NYC DEP regulatory requirements. Understanding what those regulations mean for a specific parcel is essential before any management plan is put in writing.
    </p>

    <h2 class="text-2xl font-bold text-[#1a3c1a] mt-10 mb-4">Local Forestry Context — Shokan</h2>
    <p class="text-gray-700 leading-relaxed mb-4">
      The Route 28 corridor through the Town of Olive is a gateway community — a mix of year-round landowners and vacation property holders who own woodland acreage ranging from small lots to large forested parcels. Many of these properties haven't had a professional timber or management assessment in years, if ever.
    </p>
    <p class="text-gray-700 leading-relaxed mb-4">
      Environmental Forest Products serves Shokan landowners for timber appraisals, 480-a enrollment, competitive timber sale management, and long-term management planning. Henry Kowalec provides on-site assessments for every engagement.
    </p>

    <h2 class="text-2xl font-bold text-[#1a3c1a] mt-10 mb-4">Services Available Near Shokan</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-10">
      {services.map(svc => (
        <a href={'/services/' + svc.slug} class="flex items-start gap-3 p-4 border border-gray-200 rounded-lg hover:border-[#2d5a2d] hover:bg-green-50 transition-colors group">
          <span class="text-2xl flex-shrink-0" aria-hidden="true">{svc.icon}</span>
          <div>
            <div class="font-semibold text-[#1a3c1a] group-hover:text-[#2d5a2d] text-sm">{svc.name}</div>
            <div class="text-xs text-gray-500 mt-0.5 leading-snug">{svc.excerpt.split('—')[0].trim()}</div>
          </div>
        </a>
      ))}
    </div>

    <div class="bg-green-50 border border-green-200 rounded-lg p-6 my-10">
      <h3 class="font-bold text-[#1a3c1a] text-lg mb-2">480-a Forest Tax Law — Shokan Area Properties</h3>
      <p class="text-gray-700 text-sm mb-3">
        New York's 480-a Forest Tax Law program provides a property and school tax exemption of up to 80% on enrolled woodland acreage for qualifying landowners with 50 or more contiguous acres. Town of Olive properties with the right forest character are strong candidates. Environmental Forest Products prepares the required DEC-approved management plans and manages the full enrollment process.
      </p>
      <a href="/services/480a-forest-tax-law" class="text-[#2d5a2d] font-semibold text-sm underline hover:text-[#1a3c1a]">Learn about 480-a enrollment for Ulster County landowners →</a>
    </div>

    <h2 class="text-2xl font-bold text-[#1a3c1a] mt-10 mb-4">Why Shokan Landowners Work With EFP</h2>
    <p class="text-gray-700 leading-relaxed mb-4">
      Henry Kowalec has conducted timber assessments, harvest operations, and land management work across Ulster County for more than 30 years — including on properties with the Route 28 corridor terrain in the Town of Olive and the red oak and mixed hardwood forest composition that characterizes the Shokan area. That site-specific experience includes direct familiarity with the Ashokan watershed regulatory framework — context that out-of-area consultants frequently lack.
    </p>

    <div class="bg-[#1a3c1a] text-white rounded-lg p-6 my-10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <p class="font-bold text-lg mb-1">Schedule a Site Visit in Shokan</p>
        <p class="text-green-200 text-sm">On-site assessment — not a phone estimate. We walk the property with you.</p>
      </div>
      <a href="tel:+18454980208" class="inline-flex items-center gap-2 bg-white text-[#1a3c1a] font-bold px-5 py-3 rounded hover:bg-green-100 transition-colors text-sm whitespace-nowrap flex-shrink-0">
        <svg class="w-4 h-4" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20"><path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/></svg>
        (845) 754-8242
      </a>
    </div>

    <FAQSection items={faqs} />

    <div class="border border-gray-200 rounded-lg p-5 my-10">
      <h3 class="font-semibold text-[#1a3c1a] mb-3 text-sm uppercase tracking-wide">Other Ulster County Communities We Serve</h3>
      <div class="flex flex-wrap gap-3 mb-4">
        <a href="/locations/ulster-county-ny/west-shokan" class="text-sm text-[#2d5a2d] hover:underline">West Shokan</a>
        <a href="/locations/ulster-county-ny/olivebridge" class="text-sm text-[#2d5a2d] hover:underline">Olivebridge</a>
        <a href="/locations/ulster-county-ny/boiceville" class="text-sm text-[#2d5a2d] hover:underline">Boiceville</a>
        <a href="/locations/ulster-county-ny/phoenicia" class="text-sm text-[#2d5a2d] hover:underline">Phoenicia</a>
        <a href="/locations/ulster-county-ny" class="text-sm text-[#2d5a2d] hover:underline font-semibold">View all Ulster County towns →</a>
      </div>
      <div>
        <p class="text-xs text-gray-500 uppercase tracking-wide mb-2">Also Serving Nearby Counties</p>
        <div class="flex flex-wrap gap-3">
          <a href="/locations/sullivan-county-ny" class="text-sm text-[#2d5a2d] hover:underline">Sullivan County, NY</a>
          <a href="/locations/orange-county-ny" class="text-sm text-[#2d5a2d] hover:underline">Orange County, NY</a>
        </div>
      </div>
    </div>

    <EstimateForm variant="b2c" />
  </article>
</LocationLayout>
