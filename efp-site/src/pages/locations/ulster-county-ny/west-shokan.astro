---
// West Shokan, Ulster County — individual static location page
import LocationLayout from '../../../layouts/LocationLayout.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import Breadcrumb from '../../../components/ui/Breadcrumb.astro';
import FAQSection from '../../../components/ui/FAQSection.astro';
import KeyTakeaway from '../../../components/ui/KeyTakeaway.astro';
import AuthorByline from '../../../components/ui/AuthorByline.astro';
import EstimateForm from '../../../components/forms/EstimateForm.astro';
import ServiceSchema from '../../../components/schema/ServiceSchema.astro';
import FAQSchema from '../../../components/schema/FAQSchema.astro';
import { services } from '../../../data/services';

const title       = "Forestry Consulting — West Shokan, NY | EFP";
const description = "Certified forestry consulting in West Shokan, Ulster County. 480-a Forest Tax Law, timber harvesting, and woodlot management near the Ashokan Reservoir. Henry Kowalec, 30+ years experience. Call (845) 754-8242.";
const canonicalUrl = "https://eforestproducts.com/locations/ulster-county-ny/west-shokan";

const crumbs = [
  { label: "Home",      href: "/" },
  { label: "Locations", href: "/locations" },
  { label: "Ulster County, NY", href: "/locations/ulster-county-ny" },
  { label: "West Shokan", href: "/locations/ulster-county-ny/west-shokan" },
];

const faqs = [
  { question: "Do you provide forestry consulting near West Shokan, NY?", answer: "Yes. Environmental Forest Products serves private landowners in West Shokan and throughout Ulster County. Henry Kowalec has 30+ years of hands-on forestry experience in the Ashokan Reservoir watershed area and provides on-site assessments for all service inquiries. Call (845) 754-8242." },
  { question: "Are there NYC DEP regulations that affect forestry on my West Shokan property?", answer: "Properties in the Town of Olive near the Ashokan Reservoir and its tributaries may be subject to NYC DEP regulations governing forestry and land-disturbing activities in the New York City watershed. Henry Kowalec has worked on properties in this zone and understands what those regulatory requirements mean for specific parcels — a factor that out-of-area consultants frequently underestimate." },
  { question: "Does my West Shokan property qualify for 480-a Forest Tax Law enrollment?", answer: "New York's 480-a program generally requires 50 or more contiguous acres of qualifying woodland. Properties in the Town of Olive are frequently strong candidates. NYC DEP watershed regulations must be factored into the management plan where applicable, but do not automatically disqualify a property. An on-site assessment is the only way to confirm eligibility." },
  { question: "Can you appraise the timber value on my West Shokan property?", answer: "Yes. A timber appraisal identifies species, diameter, volume, and current stumpage market value. The mixed hardwood and hemlock stands in the West Shokan area hold timber value that most landowners have not had independently assessed. An independent appraisal establishes a baseline before any negotiation begins." },
  { question: "Do you handle woodlot management near West Shokan?", answer: "Yes. Long-term woodlot management planning is available for West Shokan and the surrounding Town of Olive. A DEC-approved forest management plan is required for 480-a enrollment. Henry Kowalec prepares these plans and manages the full DEC certification process." },
];
---

<LocationLayout title={title} description={description} canonicalUrl={canonicalUrl}>
  <ServiceSchema
    pageType="location"
    serviceName="Forestry Consulting — West Shokan, Ulster County"
    description={description}
    url={canonicalUrl}
    areaServed={["West Shokan, NY", "Ulster County, NY"]}
    crumbs={crumbs}
  />
  <FAQSchema items={faqs} />
  <Breadcrumb crumbs={crumbs} />

  <PageHero
    title="Forestry Consulting in West Shokan, NY"
    subtitle="Serving West Shokan and the Ashokan Reservoir corridor — certified forestry for private landowners"
  />

  <article class="max-w-4xl mx-auto my-8 sm:my-10 px-8 sm:px-12 py-10 bg-white rounded-2xl shadow-md ring-1 ring-gray-200">

    <KeyTakeaway
      text="Environmental Forest Products provides certified forestry consulting for West Shokan area landowners. Henry Kowalec brings 30+ years of experience in Ulster County — including direct familiarity with the Ashokan Reservoir watershed and the NYC DEP regulations that affect forestry operations in the Town of Olive."
    />

    <AuthorByline />

    <h2 class="text-2xl font-bold text-[#1a3c1a] mt-10 mb-4">West Shokan's Woodland and Forest Terrain</h2>
    <p class="text-gray-700 leading-relaxed mb-4">
      West Shokan is a hamlet in the Town of Olive, situated along the Ashokan Reservoir corridor in central Ulster County. The forest here is mixed hardwood and hemlock — red oak, red maple, black birch, and hemlock in the protected drainages — on Catskill foothill terrain west of the reservoir. The Town of Olive is predominantly forested, with large parcels that have often gone without formal assessment for years.
    </p>
    <p class="text-gray-700 leading-relaxed mb-4">
      Properties in this area fall within or near the New York City DEP watershed zone, which establishes regulatory requirements for forestry and land-disturbing operations near reservoir tributaries. Knowing which regulations apply to a specific parcel is the essential first step before any management plan is prepared.
    </p>

    <h2 class="text-2xl font-bold text-[#1a3c1a] mt-10 mb-4">Local Forestry Context — West Shokan</h2>
    <p class="text-gray-700 leading-relaxed mb-4">
      The Ashokan Reservoir and its surrounding watershed represent one of the most ecologically sensitive forestry environments in Ulster County. Landowners here often hold substantial forested acreage with significant timber and tax law value — but need a consulting forester who understands both the forestry opportunity and the regulatory framework. Henry Kowalec has worked on properties throughout the Town of Olive and advises landowners on both dimensions.
    </p>

    <h2 class="text-2xl font-bold text-[#1a3c1a] mt-10 mb-4">Services Available Near West Shokan</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-10">
      {services.map(svc => (
        <a href={'/services/' + svc.slug} class="flex items-start gap-3 p-4 border border-gray-200 rounded-lg hover:border-[#2d5a2d] hover:bg-green-50 transition-colors group">
          <span class="text-2xl flex-shrink-0" aria-hidden="true">{svc.icon}</span>
          <div>
            <div class="font-semibold text-[#1a3c1a] group-hover:text-[#2d5a2d] text-sm">{svc.name}</div>
            <div class="text-xs text-gray-500 mt-0.5 leading-snug">{svc.excerpt.split('—')[0].trim()}</div>
          </div>
        </a>
      ))}
    </div>

    <div class="bg-green-50 border border-green-200 rounded-lg p-6 my-10">
      <h3 class="font-bold text-[#1a3c1a] text-lg mb-2">480-a Forest Tax Law — West Shokan Area Properties</h3>
      <p class="text-gray-700 text-sm mb-3">
        New York's 480-a Forest Tax Law program provides a property and school tax exemption of up to 80% on enrolled woodland acreage for qualifying landowners with 50 or more contiguous acres. The Town of Olive's large forested parcels make many properties strong candidates for enrollment. Environmental Forest Products prepares DEC-approved management plans — including the NYC DEP coordination required for watershed-zone properties — and manages the full enrollment process.
      </p>
      <a href="/services/480a-forest-tax-law" class="text-[#2d5a2d] font-semibold text-sm underline hover:text-[#1a3c1a]">Learn about 480-a enrollment for Ulster County landowners →</a>
    </div>

    <h2 class="text-2xl font-bold text-[#1a3c1a] mt-10 mb-4">Why West Shokan Landowners Work With EFP</h2>
    <p class="text-gray-700 leading-relaxed mb-4">
      Henry Kowalec has conducted timber assessments, harvest operations, and land management work across Ulster County for more than 30 years — including on properties with the Ashokan Reservoir corridor terrain in the Town of Olive and the red oak and hemlock-dominant forest composition that characterizes the West Shokan area. That accumulated site-specific experience — including direct familiarity with the NYC DEP watershed regulatory framework — means he can evaluate a property in West Shokan with context that out-of-area consultants cannot replicate.
    </p>

    <div class="bg-[#1a3c1a] text-white rounded-lg p-6 my-10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <p class="font-bold text-lg mb-1">Schedule a Site Visit in West Shokan</p>
        <p class="text-green-200 text-sm">On-site assessment — not a phone estimate. We walk the property with you.</p>
      </div>
      <a href="tel:+18454980208" class="inline-flex items-center gap-2 bg-white text-[#1a3c1a] font-bold px-5 py-3 rounded hover:bg-green-100 transition-colors text-sm whitespace-nowrap flex-shrink-0">
        <svg class="w-4 h-4" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20"><path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/></svg>
        (845) 754-8242
      </a>
    </div>

    <FAQSection items={faqs} />

    <div class="border border-gray-200 rounded-lg p-5 my-10">
      <h3 class="font-semibold text-[#1a3c1a] mb-3 text-sm uppercase tracking-wide">Other Ulster County Communities We Serve</h3>
      <div class="flex flex-wrap gap-3 mb-4">
        <a href="/locations/ulster-county-ny/shokan" class="text-sm text-[#2d5a2d] hover:underline">Shokan</a>
        <a href="/locations/ulster-county-ny/olivebridge" class="text-sm text-[#2d5a2d] hover:underline">Olivebridge</a>
        <a href="/locations/ulster-county-ny/boiceville" class="text-sm text-[#2d5a2d] hover:underline">Boiceville</a>
        <a href="/locations/ulster-county-ny/west-hurley" class="text-sm text-[#2d5a2d] hover:underline">West Hurley</a>
        <a href="/locations/ulster-county-ny" class="text-sm text-[#2d5a2d] hover:underline font-semibold">View all Ulster County towns →</a>
      </div>
      <div>
        <p class="text-xs text-gray-500 uppercase tracking-wide mb-2">Also Serving Nearby Counties</p>
        <div class="flex flex-wrap gap-3">
          <a href="/locations/sullivan-county-ny" class="text-sm text-[#2d5a2d] hover:underline">Sullivan County, NY</a>
          <a href="/locations/orange-county-ny" class="text-sm text-[#2d5a2d] hover:underline">Orange County, NY</a>
        </div>
      </div>
    </div>

    <EstimateForm variant="b2c" />
  </article>
</LocationLayout>
