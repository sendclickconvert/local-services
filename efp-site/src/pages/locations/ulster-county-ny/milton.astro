---
// Milton, Ulster County — individual static location page
import LocationLayout from '../../../layouts/LocationLayout.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import Breadcrumb from '../../../components/ui/Breadcrumb.astro';
import FAQSection from '../../../components/ui/FAQSection.astro';
import KeyTakeaway from '../../../components/ui/KeyTakeaway.astro';
import AuthorByline from '../../../components/ui/AuthorByline.astro';
import EstimateForm from '../../../components/forms/EstimateForm.astro';
import ServiceSchema from '../../../components/schema/ServiceSchema.astro';
import FAQSchema from '../../../components/schema/FAQSchema.astro';
import { services } from '../../../data/services';

const title       = "Forestry Consulting — Milton, NY | EFP";
const description = "Certified forestry consulting in Milton, Ulster County. 480-a Forest Tax Law, timber harvesting, land clearing, and woodlot management for Hudson Valley landowners. Henry Kowalec, 30+ years experience. Call (845) 754-8242.";
const canonicalUrl = "https://eforestproducts.com/locations/ulster-county-ny/milton";

const crumbs = [
  { label: "Home",      href: "/" },
  { label: "Locations", href: "/locations" },
  { label: "Ulster County, NY", href: "/locations/ulster-county-ny" },
  { label: "Milton", href: "/locations/ulster-county-ny/milton" },
];

const faqs = [
  { question: "Do you provide forestry consulting near Milton, NY?", answer: "Yes. Environmental Forest Products serves private landowners in Milton and throughout Ulster County. Henry Kowalec has 30+ years of hands-on forestry experience in the Hudson Valley region and provides on-site assessments for all service inquiries. Call (845) 754-8242 to discuss your property." },
  { question: "What does a forestry site assessment in Milton involve?", answer: "An initial site visit covers the key questions: what species are present, what the timber volume and size-class distribution looks like, whether the property qualifies for the 480-a Forest Tax Law program, and what management approach makes the most sense given the landowner's objectives. Visits typically take 1–3 hours depending on parcel size and terrain." },
  { question: "Does my Milton property qualify for 480-a Forest Tax Law enrollment?", answer: "New York's 480-a program generally requires 50 or more contiguous acres of qualifying woodland. Properties in the Milton area with sufficient forested acreage and appropriate species composition may qualify. The only way to determine eligibility for a specific parcel is an on-site assessment — call (845) 754-8242 to schedule one." },
  { question: "Can you appraise the timber value on my Milton property?", answer: "Yes. A timber appraisal identifies species, diameter, volume, and current stumpage market value for the trees on your property. The Hudson River bluff terrain in the Milton area supports red oak, tulip poplar, and black cherry — species with active buyer markets. An independent appraisal establishes a baseline before any sale negotiation begins." },
  { question: "Do you handle land clearing in the Milton area?", answer: "Yes. Land clearing for residential and commercial site preparation is part of EFP's service offering throughout Ulster County. Every clearing project starts with a timber assessment — if merchantable trees are present, EFP recovers that value through a timber sale before the land is cleared rather than chipping or burning material with real market worth." },
];
---

<LocationLayout title={title} description={description} canonicalUrl={canonicalUrl}>
  <ServiceSchema
    pageType="location"
    serviceName="Forestry Consulting — Milton, Ulster County"
    description={description}
    url={canonicalUrl}
    areaServed={["Milton, NY", "Ulster County, NY"]}
    crumbs={crumbs}
  />
  <FAQSchema items={faqs} />

  <Breadcrumb crumbs={crumbs} />

  <PageHero
    title="Forestry Consulting in Milton, NY"
    subtitle="Serving Milton and the Hudson Valley communities of Ulster County — certified forestry for private landowners"
  />

  <article class="max-w-4xl mx-auto my-8 sm:my-10 px-8 sm:px-12 py-10 bg-white rounded-2xl shadow-md ring-1 ring-gray-200">

    <KeyTakeaway
      text="Environmental Forest Products provides certified forestry consulting for Milton area landowners. Henry Kowalec brings 30+ years of hands-on experience in Ulster County — on-site assessments for 480-a enrollment, timber value, land clearing, and long-term woodland management."
    />

    <AuthorByline />

    <h2 class="text-2xl font-bold text-[#1a3c1a] mt-10 mb-4">Milton's Woodland and Forest Terrain</h2>
    <p class="text-gray-700 leading-relaxed mb-4">
      Milton is a hamlet in the Town of Marlborough, situated on the Hudson River bluffs in the eastern part of Ulster County. The woodland here reflects the classic lower Hudson Valley species mix: red oak, tulip poplar, black cherry, and red maple dominate the upland terrain, with a history of orchard and agricultural land use throughout the area. Development pressure along this part of the Hudson is significant, and timber assessments ahead of clearing or site preparation are common requests.
    </p>
    <p class="text-gray-700 leading-relaxed mb-4">
      Black cherry from the Milton area — when properly graded and sold through a competitive process — commands strong prices from cabinet and furniture buyers. Red oak from the Hudson Valley bluffs finds active markets among flooring mills and structural lumber buyers throughout the region.
    </p>

    <h2 class="text-2xl font-bold text-[#1a3c1a] mt-10 mb-4">Local Forestry Context — Milton</h2>
    <p class="text-gray-700 leading-relaxed mb-4">
      The Town of Marlborough, which includes Milton, occupies the Hudson River bluffs across from Poughkeepsie. The landscape here is a mix of orchard land — the area has a long apple-growing history — agricultural fields, and woodland parcels on the upland terrain. Many woodland parcels in this area have not been assessed in years, and landowners frequently hold timber value that has never been independently confirmed.
    </p>
    <p class="text-gray-700 leading-relaxed mb-4">
      Environmental Forest Products serves Milton landowners for timber appraisals, competitive timber sale management, land clearing with timber recovery, and long-term management planning. Henry Kowalec provides on-site assessments for every engagement — not phone estimates based on acreage alone.
    </p>

    <h2 class="text-2xl font-bold text-[#1a3c1a] mt-10 mb-4">Services Available Near Milton</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-10">
      {services.map(svc => (
        <a
          href={'/services/' + svc.slug}
          class="flex items-start gap-3 p-4 border border-gray-200 rounded-lg hover:border-[#2d5a2d] hover:bg-green-50 transition-colors group"
        >
          <span class="text-2xl flex-shrink-0" aria-hidden="true">{svc.icon}</span>
          <div>
            <div class="font-semibold text-[#1a3c1a] group-hover:text-[#2d5a2d] text-sm">{svc.name}</div>
            <div class="text-xs text-gray-500 mt-0.5 leading-snug">{svc.excerpt.split('—')[0].trim()}</div>
          </div>
        </a>
      ))}
    </div>

    <h2 class="text-2xl font-bold text-[#1a3c1a] mt-10 mb-4">Timber Value and Harvest Planning Near Milton</h2>
    <p class="text-gray-700 leading-relaxed mb-4">
      Private woodland in the Milton area holds timber value that most landowners have never had independently confirmed. Stumpage prices for red oak and black cherry shift with regional mill demand and market conditions, and an estimate from several years ago may be significantly off today. An independent appraisal establishes what the timber is actually worth at current competitive market prices before any buyer negotiation begins.
    </p>

    <div class="bg-green-50 border border-green-200 rounded-lg p-6 my-10">
      <h3 class="font-bold text-[#1a3c1a] text-lg mb-2">480-a Forest Tax Law — Milton Area Properties</h3>
      <p class="text-gray-700 text-sm mb-3">
        New York's 480-a Forest Tax Law program allows woodland owners with 50 or more contiguous acres of qualifying forest to apply for a property and school tax exemption of up to 80% on enrolled acreage. The program requires a DEC-approved forest management plan prepared by a certified consulting forester.
      </p>
      <p class="text-gray-700 text-sm mb-4">
        Environmental Forest Products prepares these plans for Ulster County landowners and manages the full DEC certification process. If your Milton area parcel meets the acreage threshold, an on-site assessment will determine whether the forest condition qualifies.
      </p>
      <a href="/services/480a-forest-tax-law" class="text-[#2d5a2d] font-semibold text-sm underline hover:text-[#1a3c1a]">Learn about 480-a enrollment for Ulster County landowners →</a>
    </div>

    <h2 class="text-2xl font-bold text-[#1a3c1a] mt-10 mb-4">Land Clearing Near Milton</h2>
    <p class="text-gray-700 leading-relaxed mb-4">
      Development pressure in the Milton and Town of Marlborough area generates regular demand for land clearing. The Hudson River bluff terrain here involves drainage patterns and potential erosion risk on sloped parcels — considerations that need to be addressed in the clearing plan before equipment is mobilized. Where merchantable timber is present, EFP recovers that value through a timber sale before clearing begins, reducing the net project cost.
    </p>
    <p class="text-gray-700 leading-relaxed mb-6">
      Learn more about <a href="/services/land-clearing" class="text-[#2d5a2d] underline hover:text-[#1a3c1a]">land clearing services in Ulster County</a>, or contact EFP to discuss a specific site near Milton.
    </p>

    <h2 class="text-2xl font-bold text-[#1a3c1a] mt-10 mb-4">Why Milton Landowners Work With EFP</h2>
    <p class="text-gray-700 leading-relaxed mb-4">
      Henry Kowalec has conducted timber assessments, harvest operations, and land management work across Ulster County for more than 30 years — including on properties with the Hudson River bluff terrain in the Town of Marlborough and the red oak and tulip poplar-dominant forest composition that characterizes the Milton area. That accumulated site-specific experience means he can evaluate a property in Milton with the context of hundreds of comparable assessments in this same region.
    </p>
    <p class="text-gray-700 leading-relaxed mb-4">
      Environmental Forest Products is headquartered in Westbrookville, Sullivan County — not a regional franchise or an out-of-area firm taking remote bids. When Henry walks your property in Milton, he brings direct familiarity with Ulster County's terrain, access conditions, timber markets, and 480-a program requirements.
    </p>

    <div class="bg-[#1a3c1a] text-white rounded-lg p-6 my-10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <p class="font-bold text-lg mb-1">Schedule a Site Visit in Milton</p>
        <p class="text-green-200 text-sm">On-site assessment — not a phone estimate. We walk the property with you.</p>
      </div>
      <a
        href="tel:+18454980208"
        class="inline-flex items-center gap-2 bg-white text-[#1a3c1a] font-bold px-5 py-3 rounded hover:bg-green-100 transition-colors text-sm whitespace-nowrap flex-shrink-0"
      >
        <svg class="w-4 h-4" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20"><path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/></svg>
        (845) 754-8242
      </a>
    </div>

    <FAQSection items={faqs} />

    <div class="border border-gray-200 rounded-lg p-5 my-10">
      <h3 class="font-semibold text-[#1a3c1a] mb-3 text-sm uppercase tracking-wide">
        Other Ulster County Communities We Serve
      </h3>
      <div class="flex flex-wrap gap-3 mb-4">
        <a href="/locations/ulster-county-ny/marlboro" class="text-sm text-[#2d5a2d] hover:underline">Marlboro</a>
        <a href="/locations/ulster-county-ny/clintondale" class="text-sm text-[#2d5a2d] hover:underline">Clintondale</a>
        <a href="/locations/ulster-county-ny/lloyd" class="text-sm text-[#2d5a2d] hover:underline">Lloyd</a>
        <a href="/locations/ulster-county-ny/new-paltz" class="text-sm text-[#2d5a2d] hover:underline">New Paltz</a>
        <a href="/locations/ulster-county-ny" class="text-sm text-[#2d5a2d] hover:underline font-semibold">View all Ulster County towns →</a>
      </div>
      <div>
        <p class="text-xs text-gray-500 uppercase tracking-wide mb-2">Also Serving Nearby Counties</p>
        <div class="flex flex-wrap gap-3">
          <a href="/locations/sullivan-county-ny" class="text-sm text-[#2d5a2d] hover:underline">Sullivan County, NY</a>
          <a href="/locations/orange-county-ny" class="text-sm text-[#2d5a2d] hover:underline">Orange County, NY</a>
        </div>
      </div>
    </div>

    <EstimateForm variant="b2c" />

  </article>
</LocationLayout>
