---
// Lafayette, Sussex County — individual static location page
// Generated by scripts/generate-town-pages.ts
// Content is derived entirely from this town's unique data fields.
import LocationLayout from '../../../layouts/LocationLayout.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import Breadcrumb from '../../../components/ui/Breadcrumb.astro';
import FAQSection from '../../../components/ui/FAQSection.astro';
import KeyTakeaway from '../../../components/ui/KeyTakeaway.astro';
import AuthorByline from '../../../components/ui/AuthorByline.astro';
import EstimateForm from '../../../components/forms/EstimateForm.astro';
import ServiceSchema from '../../../components/schema/ServiceSchema.astro';
import FAQSchema from '../../../components/schema/FAQSchema.astro';
import { services } from '../../../data/services';

const title       = "Forestry Consulting — Lafayette, NJ | EFP";
const description = "Certified forestry consulting in Lafayette, Sussex County. land clearing, timber harvesting, and woodlot management for local landowners. Henry Kowalec, 30+ years experience. Call (845) 754-8242.";
const canonicalUrl = "https://eforestproducts.com/locations/sussex-county-nj/lafayette";

const crumbs = [
  { label: "Home",      href: "/" },
  { label: "Locations", href: "/locations" },
  { label: "Sussex County, NJ", href: "/locations/sussex-county-nj" },
  { label: "Lafayette", href: "/locations/sussex-county-nj/lafayette" },
];

const faqs = [
  { question: "Do you provide forestry consulting near Lafayette, NJ?", answer: "Yes. Environmental Forest Products serves private landowners in Lafayette and throughout Sussex County. Henry Kowalec has 30+ years of hands-on forestry experience in this region and provides on-site assessments for all service inquiries. Call (845) 754-8242 to discuss your property." },
  { question: "What does a forestry site assessment in Lafayette involve?", answer: "An initial site visit covers the key questions: what species are present, what the timber volume and size-class distribution looks like, whether the property qualifies for New Jersey's Farmland Assessment program, and what management approach — harvest, improvement cutting, or a long-term management plan — makes the most sense given the landowner's objectives. Visits typically take 1–3 hours depending on parcel size and terrain." },
  { question: "Are there woodland tax programs for New Jersey landowners near Lafayette?", answer: "New Jersey's Farmland Assessment Act can reduce property taxes on qualifying woodland parcels of five or more acres. A woodland management plan supports Farmland Assessment eligibility and is also the foundation of any timber sale or long-term management work. Contact Henry Kowalec to discuss the options applicable to your Lafayette property." },
  { question: "Can you appraise the timber value on my Lafayette property?", answer: "Yes. A timber appraisal identifies species, diameter, volume, and current stumpage market value for the trees on your property. This provides an independent baseline for evaluating any buyer offers you receive and determines whether a competitive bid process is warranted. Sussex County properties with mature red oak stands frequently have more timber value than the landowner expects." },
  { question: "Do you handle land clearing in the Lafayette area?", answer: "Yes. Land clearing for residential and commercial site preparation is part of EFP's service offering throughout Sussex County. Every clearing project starts with a timber assessment — if merchantable trees are present, EFP recovers that value through a timber sale before the land is cleared rather than chipping or burning material with real market worth. This step typically reduces the net cost of the project." },
];
---

<LocationLayout title={title} description={description} canonicalUrl={canonicalUrl}>
  <ServiceSchema
    pageType="location"
    serviceName="Forestry Consulting — Lafayette, Sussex County"
    description={description}
    url={canonicalUrl}
    areaServed={["Lafayette, NJ", "Sussex County, NJ"]}
    crumbs={crumbs}
  />
  <FAQSchema items={faqs} />

  <Breadcrumb crumbs={crumbs} />

  <PageHero
    title="Forestry Consulting in Lafayette, NJ"
    subtitle="Serving Lafayette and Sussex County — certified forestry for private landowners"
  />

  <article class="max-w-4xl mx-auto my-8 sm:my-10 px-8 sm:px-12 py-10 bg-white rounded-2xl shadow-md ring-1 ring-gray-200">

    <KeyTakeaway
      text="Environmental Forest Products provides certified forestry consulting for Lafayette area landowners. Henry Kowalec brings 30+ years of hands-on experience in Sussex County — on-site assessments for timber value, land clearing, and long-term woodland management."
    />

    <AuthorByline />

    <!-- SECTION 1: Terrain + Species ─────────────────────── -->
    <h2 class="text-2xl font-bold text-[#1a3c1a] mt-10 mb-4">Lafayette's Woodland and Forest Terrain</h2>
    <p class="text-gray-700 leading-relaxed mb-4">
      Rural Sussex County community near the New York border with mixed woodland. The forest composition in this area is dominated by red oak, red maple, and black cherry — a species mix that defines both the timber market opportunity and the management approach suited to properties in this part of Sussex County.
    </p>
    <p class="text-gray-700 leading-relaxed mb-4">
      Black cherry is among the most valuable cabinet and furniture species in the northeastern hardwood market, and Sussex County properties with quality cherry stands command strong stumpage prices when properly bid through a competitive process. Red oak from this region is actively sought by flooring mills, structural lumber buyers, and hardwood distributors throughout the area.
    </p>
    

    <!-- SECTION 2: Local Context ─────────────────────────── -->
    <h2 class="text-2xl font-bold text-[#1a3c1a] mt-10 mb-4">Local Forestry Context — Lafayette</h2>
    <p class="text-gray-700 leading-relaxed mb-4">
      Lafayette is a small rural community in northern Sussex County near the New York state border. The proximity to the primary EFP service area in Orange County, NY makes Lafayette a natural extension of the service territory. Timber and land management services are available for landowners in this area.
    </p>
    <p class="text-gray-700 leading-relaxed mb-4">
      Environmental Forest Products serves Lafayette landowners for the full range of forestry consulting — timber appraisals, competitive timber sale management, land clearing with timber recovery, and long-term management planning. Henry Kowalec is a certified consulting forester with 30+ years of experience in Sussex County. Every engagement starts with an on-site assessment of your specific property, not a phone estimate based on acreage alone.
    </p>

    <!-- SECTION 3: Services ──────────────────────────────── -->
    <h2 class="text-2xl font-bold text-[#1a3c1a] mt-10 mb-4">Services Available Near Lafayette</h2>
    <p class="text-gray-700 leading-relaxed mb-4">
      The following services are available to Sussex County landowners in the Lafayette area. Each starts with a site assessment that accounts for the actual conditions on your specific property.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-10">
      {services.map(svc => (
        <a
          href={'/services/' + svc.slug}
          class="flex items-start gap-3 p-4 border border-gray-200 rounded-lg hover:border-[#2d5a2d] hover:bg-green-50 transition-colors group"
        >
          <span class="text-2xl flex-shrink-0" aria-hidden="true">{svc.icon}</span>
          <div>
            <div class="font-semibold text-[#1a3c1a] group-hover:text-[#2d5a2d] text-sm">{svc.name}</div>
            <div class="text-xs text-gray-500 mt-0.5 leading-snug">{svc.excerpt.split('—')[0].trim()}</div>
          </div>
        </a>
      ))}
    </div>

    <!-- SECTION 4: Timber Value ──────────────────────────── -->
    <h2 class="text-2xl font-bold text-[#1a3c1a] mt-10 mb-4">Timber Value and Harvest Planning Near Lafayette</h2>
    <p class="text-gray-700 leading-relaxed mb-4">
      Private woodland in the Lafayette area — carrying red oak, red maple, and black cherry — holds timber value that most landowners have never had independently confirmed. Stumpage prices shift with regional mill demand and market conditions, and an estimate that was current three or five years ago may be significantly off today. Without an independent appraisal, there is no reliable baseline for evaluating any offer a buyer presents.
    </p>
    <p class="text-gray-700 leading-relaxed mb-4">
      Environmental Forest Products provides independent timber appraisals — not affiliated with any logging contractor — which means the appraisal reflects what the timber is worth at competitive market prices. When a harvest is appropriate, Henry Kowalec manages the competitive bidding process for Sussex County landowners, reaching the buyers who most actively purchase red oak and related species in this region.
    </p>
    
    <div class="bg-green-50 border border-green-200 rounded-lg p-6 my-10">
      <h3 class="font-bold text-[#1a3c1a] text-lg mb-2">Farmland Assessment — Lafayette Area Woodland Properties</h3>
      <p class="text-gray-700 text-sm mb-4">
        New Jersey's Farmland Assessment Act provides preferential tax treatment for qualifying woodland and agricultural
        parcels of five or more acres. Enrolled properties are assessed at agricultural use value rather than fair
        market value, which can reduce annual property taxes for Sussex County landowners with qualifying woodland.
        A management plan prepared by a certified forester supports Farmland Assessment eligibility and is also the
        foundation of a timber sale or long-term woodland management program. Contact Henry Kowalec to discuss the
        specific options applicable to your Lafayette property.
      </p>
      <a href="/services/woodlot-management" class="text-[#2d5a2d] font-semibold text-sm underline hover:text-[#1a3c1a]">Learn about woodland management planning →</a>
    </div>

    <!-- SECTION 5: Land Clearing ─────────────────────────── -->
    <h2 class="text-2xl font-bold text-[#1a3c1a] mt-10 mb-4">Land Clearing Near Lafayette</h2>
    <p class="text-gray-700 leading-relaxed mb-4">
      Land clearing near Lafayette benefits from the relatively accessible rolling terrain typical of this part of Sussex County. Standard clearing equipment can reach most sites with proper access road planning, and EFP's pre-clearing assessment identifies any sensitive features — drainage swales, steep faces, wet areas, or high-value timber — before work begins.
    </p>
    <p class="text-gray-700 leading-relaxed mb-4">
      Where merchantable timber is present on a clearing site, recovering that value before the land is cleared reduces the net cost of the project. This requires a forester's assessment before equipment arrives — a step that most site contractors skip and that a certified forestry professional will always perform.
    </p>
    <p class="text-gray-700 leading-relaxed mb-6">
      Learn more about <a href="/services/land-clearing" class="text-[#2d5a2d] underline hover:text-[#1a3c1a]">land clearing services in Sussex County</a>, or contact EFP to discuss a specific site near Lafayette.
    </p>

    <!-- SECTION 6: Why EFP ───────────────────────────────── -->
    <h2 class="text-2xl font-bold text-[#1a3c1a] mt-10 mb-4">Why Lafayette Landowners Work With EFP</h2>
    <p class="text-gray-700 leading-relaxed mb-4">
      Henry Kowalec has conducted timber assessments, harvest operations, and land management work across Sussex County for more than 30 years — including on properties with the rural sussex county community near the new york border with mixed woodland and the red oak-dominant forest composition that characterizes the Lafayette area. That accumulated site-specific experience means he can evaluate a property in Lafayette with the context of hundreds of comparable assessments in this same region, not just general forestry principles applied from the outside.
    </p>
    <p class="text-gray-700 leading-relaxed mb-4">
      Environmental Forest Products is headquartered in Westbrookville, Sullivan County — not a regional franchise or an out-of-area firm taking remote bids. When Henry walks your property in Lafayette, he brings direct familiarity with Sussex County's terrain, access conditions, timber markets, and state woodland management options — developed over decades of hands-on work throughout this region.
    </p>

    <!-- CTA ──────────────────────────────────────────────── -->
    <div class="bg-[#1a3c1a] text-white rounded-lg p-6 my-10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <p class="font-bold text-lg mb-1">Schedule a Site Visit in Lafayette</p>
        <p class="text-green-200 text-sm">On-site assessment — not a phone estimate. We walk the property with you.</p>
      </div>
      <a
        href="tel:+18454980208"
        class="inline-flex items-center gap-2 bg-white text-[#1a3c1a] font-bold px-5 py-3 rounded hover:bg-green-100 transition-colors text-sm whitespace-nowrap flex-shrink-0"
      >
        <svg class="w-4 h-4" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20"><path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/></svg>
        (845) 754-8242
      </a>
    </div>

    <!-- FAQ ──────────────────────────────────────────────── -->
    <FAQSection items={faqs} />

    <!-- Sibling / neighbor links ─────────────────────────── -->
    <div class="border border-gray-200 rounded-lg p-5 my-10">
      <h3 class="font-semibold text-[#1a3c1a] mb-3 text-sm uppercase tracking-wide">
        Other Sussex County Communities We Serve
      </h3>
      <div class="flex flex-wrap gap-3 mb-4">
        <a href="/locations/sussex-county-nj/newton" class="text-sm text-[#2d5a2d] hover:underline">Newton</a>
          <a href="/locations/sussex-county-nj/sparta" class="text-sm text-[#2d5a2d] hover:underline">Sparta</a>
          <a href="/locations/sussex-county-nj/vernon" class="text-sm text-[#2d5a2d] hover:underline">Vernon</a>
          <a href="/locations/sussex-county-nj/hardyston" class="text-sm text-[#2d5a2d] hover:underline">Hardyston</a>
        <a href="/locations/sussex-county-nj" class="text-sm text-[#2d5a2d] hover:underline font-semibold">View all Sussex County towns →</a>
      </div>
      <div>
        <p class="text-xs text-gray-500 uppercase tracking-wide mb-2">Also Serving Nearby Counties</p>
        <div class="flex flex-wrap gap-3">
          <a href="/locations/orange-county-ny" class="text-sm text-[#2d5a2d] hover:underline">Orange County, NY</a>
          <a href="/locations/pike-county-pa" class="text-sm text-[#2d5a2d] hover:underline">Pike County, PA</a>
        </div>
      </div>
    </div>

    <EstimateForm variant="b2c" />

  </article>
</LocationLayout>
