---
// Glen Wild, Sullivan County — individual static location page
// Generated by scripts/generate-town-pages.ts
// Content is derived entirely from this town's unique data fields.
import LocationLayout from '../../../layouts/LocationLayout.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import Breadcrumb from '../../../components/ui/Breadcrumb.astro';
import FAQSection from '../../../components/ui/FAQSection.astro';
import KeyTakeaway from '../../../components/ui/KeyTakeaway.astro';
import AuthorByline from '../../../components/ui/AuthorByline.astro';
import EstimateForm from '../../../components/forms/EstimateForm.astro';
import ServiceSchema from '../../../components/schema/ServiceSchema.astro';
import FAQSchema from '../../../components/schema/FAQSchema.astro';
import { services } from '../../../data/services';

const title       = "Forestry Consulting — Glen Wild, NY | EFP";
const description = "Certified forestry consulting in Glen Wild, Sullivan County. 480-a Forest Tax Law, land clearing, timber harvesting, and woodlot management for local landowners. Henry Kowalec, 30+ years experience. Call (845) 754-8242.";
const canonicalUrl = "https://eforestproducts.com/locations/sullivan-county-ny/glen-wild";

const crumbs = [
  { label: "Home",      href: "/" },
  { label: "Locations", href: "/locations" },
  { label: "Sullivan County, NY", href: "/locations/sullivan-county-ny" },
  { label: "Glen Wild", href: "/locations/sullivan-county-ny/glen-wild" },
];

const faqs = [
  { question: "Do you provide forestry consulting near Glen Wild, NY?", answer: "Yes. Environmental Forest Products serves private landowners in Glen Wild and throughout Sullivan County. Henry Kowalec has 30+ years of hands-on forestry experience in this region and provides on-site assessments for all service inquiries. Call (845) 754-8242 to discuss your property." },
  { question: "What does a forestry site assessment in Glen Wild involve?", answer: "An initial site visit covers the key questions: what species are present, what the timber volume and size-class distribution looks like, whether the property qualifies for the 480-a Forest Tax Law program, and what management approach — harvest, improvement cutting, or a long-term management plan — makes the most sense given the landowner's objectives. Visits typically take 1–3 hours depending on parcel size and terrain." },
  { question: "Does my Glen Wild property qualify for 480-a Forest Tax Law enrollment?", answer: "New York's 480-a program generally requires 50 or more contiguous acres of qualifying woodland. Properties with the right acreage, forest condition, and species composition can qualify for a property and school tax exemption of up to 80% on enrolled acreage. The only way to determine whether a specific parcel qualifies is an on-site assessment — call (845) 754-8242 to schedule one." },
  { question: "Can you appraise the timber value on my Glen Wild property?", answer: "Yes. A timber appraisal identifies species, diameter, volume, and current stumpage market value for the trees on your property. This provides an independent baseline for evaluating any buyer offers you receive and determines whether a competitive bid process is warranted. Sullivan County properties with mature red maple stands frequently have more timber value than the landowner expects." },
  { question: "Do you handle land clearing in the Glen Wild area?", answer: "Yes. Land clearing for residential and commercial site preparation is part of EFP's service offering throughout Sullivan County. Every clearing project starts with a timber assessment — if merchantable trees are present, EFP recovers that value through a timber sale before the land is cleared rather than chipping or burning material with real market worth. This step typically reduces the net cost of the project." },
];
---

<LocationLayout title={title} description={description} canonicalUrl={canonicalUrl}>
  <ServiceSchema
    pageType="location"
    serviceName="Forestry Consulting — Glen Wild, Sullivan County"
    description={description}
    url={canonicalUrl}
    areaServed={["Glen Wild, NY", "Sullivan County, NY"]}
    crumbs={crumbs}
  />
  <FAQSchema items={faqs} />

  <Breadcrumb crumbs={crumbs} />

  <PageHero
    title="Forestry Consulting in Glen Wild, NY"
    subtitle="Serving Glen Wild and Sullivan County — certified forestry for private landowners"
  />

  <article class="max-w-4xl mx-auto my-8 sm:my-10 px-8 sm:px-12 py-10 bg-white rounded-2xl shadow-md ring-1 ring-gray-200">

    <KeyTakeaway
      text="Environmental Forest Products provides certified forestry consulting for Glen Wild area landowners. Henry Kowalec brings 30+ years of hands-on experience in Sullivan County — on-site assessments for 480-a enrollment, timber value, land clearing, and long-term woodland management."
    />

    <AuthorByline />

    <!-- SECTION 1: Terrain + Species ─────────────────────── -->
    <h2 class="text-2xl font-bold text-[#1a3c1a] mt-10 mb-4">Glen Wild's Woodland and Forest Terrain</h2>
    <p class="text-gray-700 leading-relaxed mb-4">
      Small south-central Sullivan County community with mature woodland on the surrounding uplands. The forest composition in this area is dominated by red maple, red oak, and black cherry — a species mix that defines both the timber market opportunity and the management approach suited to properties in this part of Sullivan County.
    </p>
    <p class="text-gray-700 leading-relaxed mb-4">
      Black cherry is among the most valuable cabinet and furniture species in the northeastern hardwood market, and Sullivan County properties with quality cherry stands command strong stumpage prices when properly bid through a competitive process. Red oak from this region is actively sought by flooring mills, structural lumber buyers, and hardwood distributors throughout the area.
    </p>
    

    <!-- SECTION 2: Local Context ─────────────────────────── -->
    <h2 class="text-2xl font-bold text-[#1a3c1a] mt-10 mb-4">Local Forestry Context — Glen Wild</h2>
    <p class="text-gray-700 leading-relaxed mb-4">
      Glen Wild is a small hamlet in the southern part of Sullivan County, with mature mixed hardwood woodland on the surrounding uplands. Like other interior Sullivan County communities, the primary forestry management questions here involve baseline assessments, 480-a eligibility screening, and periodic timber appraisals for landowners who want to understand the current and future value of their woodland investments.
    </p>
    <p class="text-gray-700 leading-relaxed mb-4">
      Environmental Forest Products serves Glen Wild landowners for the full range of forestry consulting — timber appraisals, competitive timber sale management, land clearing with timber recovery, and long-term management planning. Henry Kowalec is a certified consulting forester with 30+ years of experience in Sullivan County. Every engagement starts with an on-site assessment of your specific property, not a phone estimate based on acreage alone.
    </p>

    <!-- SECTION 3: Services ──────────────────────────────── -->
    <h2 class="text-2xl font-bold text-[#1a3c1a] mt-10 mb-4">Services Available Near Glen Wild</h2>
    <p class="text-gray-700 leading-relaxed mb-4">
      The following services are available to Sullivan County landowners in the Glen Wild area. Each starts with a site assessment that accounts for the actual conditions on your specific property.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-10">
      {services.map(svc => (
        <a
          href={'/services/' + svc.slug}
          class="flex items-start gap-3 p-4 border border-gray-200 rounded-lg hover:border-[#2d5a2d] hover:bg-green-50 transition-colors group"
        >
          <span class="text-2xl flex-shrink-0" aria-hidden="true">{svc.icon}</span>
          <div>
            <div class="font-semibold text-[#1a3c1a] group-hover:text-[#2d5a2d] text-sm">{svc.name}</div>
            <div class="text-xs text-gray-500 mt-0.5 leading-snug">{svc.excerpt.split('—')[0].trim()}</div>
          </div>
        </a>
      ))}
    </div>

    <!-- SECTION 4: Timber Value ──────────────────────────── -->
    <h2 class="text-2xl font-bold text-[#1a3c1a] mt-10 mb-4">Timber Value and Harvest Planning Near Glen Wild</h2>
    <p class="text-gray-700 leading-relaxed mb-4">
      Private woodland in the Glen Wild area — carrying red maple, red oak, and black cherry — holds timber value that most landowners have never had independently confirmed. Stumpage prices shift with regional mill demand and market conditions, and an estimate that was current three or five years ago may be significantly off today. Without an independent appraisal, there is no reliable baseline for evaluating any offer a buyer presents.
    </p>
    <p class="text-gray-700 leading-relaxed mb-4">
      Environmental Forest Products provides independent timber appraisals — not affiliated with any logging contractor — which means the appraisal reflects what the timber is worth at competitive market prices. When a harvest is appropriate, Henry Kowalec manages the competitive bidding process for Sullivan County landowners, reaching the buyers who most actively purchase red maple and related species in this region.
    </p>
    
    <div class="bg-green-50 border border-green-200 rounded-lg p-6 my-10">
      <h3 class="font-bold text-[#1a3c1a] text-lg mb-2">480-a Forest Tax Law — Glen Wild Area Properties</h3>
      <p class="text-gray-700 text-sm mb-3">
        New York's 480-a Forest Tax Law program allows woodland owners with 50 or more contiguous acres of qualifying
        forest to apply for a property and school tax exemption of up to 80% on enrolled acreage. The program requires
        a DEC-approved forest management plan prepared by a certified consulting forester — Environmental Forest Products
        prepares these plans for Sullivan County landowners and manages the full DEC certification process.
      </p>
      <p class="text-gray-700 text-sm mb-4">
        Enrollment delivers annual tax savings in exchange for a 10-year commitment to manage the forest under the
        approved plan. Henry Kowalec handles eligibility screening, plan preparation, DEC submission, and ongoing
        annual compliance guidance for enrolled Sullivan County properties.
      </p>
      <a href="/services/480a-forest-tax-law" class="text-[#2d5a2d] font-semibold text-sm underline hover:text-[#1a3c1a]">Learn about 480-a enrollment for Sullivan County landowners →</a>
    </div>

    <!-- SECTION 5: Land Clearing ─────────────────────────── -->
    <h2 class="text-2xl font-bold text-[#1a3c1a] mt-10 mb-4">Land Clearing Near Glen Wild</h2>
    <p class="text-gray-700 leading-relaxed mb-4">
      Land clearing near Glen Wild benefits from the relatively accessible rolling terrain typical of this part of Sullivan County. Standard clearing equipment can reach most sites with proper access road planning, and EFP's pre-clearing assessment identifies any sensitive features — drainage swales, steep faces, wet areas, or high-value timber — before work begins.
    </p>
    <p class="text-gray-700 leading-relaxed mb-4">
      Where merchantable timber is present on a clearing site, recovering that value before the land is cleared reduces the net cost of the project. This requires a forester's assessment before equipment arrives — a step that most site contractors skip and that a certified forestry professional will always perform.
    </p>
    <p class="text-gray-700 leading-relaxed mb-6">
      Learn more about <a href="/services/land-clearing" class="text-[#2d5a2d] underline hover:text-[#1a3c1a]">land clearing services in Sullivan County</a>, or contact EFP to discuss a specific site near Glen Wild.
    </p>

    <!-- SECTION 6: Why EFP ───────────────────────────────── -->
    <h2 class="text-2xl font-bold text-[#1a3c1a] mt-10 mb-4">Why Glen Wild Landowners Work With EFP</h2>
    <p class="text-gray-700 leading-relaxed mb-4">
      Henry Kowalec has conducted timber assessments, harvest operations, and land management work across Sullivan County for more than 30 years — including on properties with the small south-central sullivan county community with mature woodland on the surrounding uplands and the red maple-dominant forest composition that characterizes the Glen Wild area. That accumulated site-specific experience means he can evaluate a property in Glen Wild with the context of hundreds of comparable assessments in this same region, not just general forestry principles applied from the outside.
    </p>
    <p class="text-gray-700 leading-relaxed mb-4">
      Environmental Forest Products is headquartered in Westbrookville, Sullivan County — not a regional franchise or an out-of-area firm taking remote bids. When Henry walks your property in Glen Wild, he brings direct familiarity with Sullivan County's terrain, access conditions, timber markets, and 480-a program requirements — developed over decades of hands-on work throughout this region.
    </p>

    <!-- CTA ──────────────────────────────────────────────── -->
    <div class="bg-[#1a3c1a] text-white rounded-lg p-6 my-10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <p class="font-bold text-lg mb-1">Schedule a Site Visit in Glen Wild</p>
        <p class="text-green-200 text-sm">On-site assessment — not a phone estimate. We walk the property with you.</p>
      </div>
      <a
        href="tel:+18454980208"
        class="inline-flex items-center gap-2 bg-white text-[#1a3c1a] font-bold px-5 py-3 rounded hover:bg-green-100 transition-colors text-sm whitespace-nowrap flex-shrink-0"
      >
        <svg class="w-4 h-4" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20"><path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/></svg>
        (845) 754-8242
      </a>
    </div>

    <!-- FAQ ──────────────────────────────────────────────── -->
    <FAQSection items={faqs} />

    <!-- Sibling / neighbor links ─────────────────────────── -->
    <div class="border border-gray-200 rounded-lg p-5 my-10">
      <h3 class="font-semibold text-[#1a3c1a] mb-3 text-sm uppercase tracking-wide">
        Other Sullivan County Communities We Serve
      </h3>
      <div class="flex flex-wrap gap-3 mb-4">
        <a href="/locations/sullivan-county-ny/liberty" class="text-sm text-[#2d5a2d] hover:underline">Liberty</a>
          <a href="/locations/sullivan-county-ny/monticello" class="text-sm text-[#2d5a2d] hover:underline">Monticello</a>
          <a href="/locations/sullivan-county-ny/livingston-manor" class="text-sm text-[#2d5a2d] hover:underline">Livingston Manor</a>
          <a href="/locations/sullivan-county-ny/fallsburg" class="text-sm text-[#2d5a2d] hover:underline">Fallsburg</a>
        <a href="/locations/sullivan-county-ny" class="text-sm text-[#2d5a2d] hover:underline font-semibold">View all Sullivan County towns →</a>
      </div>
      <div>
        <p class="text-xs text-gray-500 uppercase tracking-wide mb-2">Also Serving Nearby Counties</p>
        <div class="flex flex-wrap gap-3">
          <a href="/locations/orange-county-ny" class="text-sm text-[#2d5a2d] hover:underline">Orange County, NY</a>
          <a href="/locations/ulster-county-ny" class="text-sm text-[#2d5a2d] hover:underline">Ulster County, NY</a>
          <a href="/locations/pike-county-pa" class="text-sm text-[#2d5a2d] hover:underline">Pike County, PA</a>
        </div>
      </div>
    </div>

    <EstimateForm variant="b2c" />

  </article>
</LocationLayout>
