---
// pages/locations/sullivan-county-ny/fallsburg.astro
// CUSTOM — Fallsburg has South Fallsburg, Loch Sheldrake, Woodridge sub-communities;
// covers the range from suburban corridor to rural woodlot.

import LocationLayout from '../../../layouts/LocationLayout.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import Breadcrumb from '../../../components/ui/Breadcrumb.astro';
import FAQSection from '../../../components/ui/FAQSection.astro';
import KeyTakeaway from '../../../components/ui/KeyTakeaway.astro';
import AuthorByline from '../../../components/ui/AuthorByline.astro';
import EstimateForm from '../../../components/forms/EstimateForm.astro';
import ServiceSchema from '../../../components/schema/ServiceSchema.astro';
import FAQSchema from '../../../components/schema/FAQSchema.astro';
import { buildTitle, buildCanonical, buildDescription } from '../../../lib/seo';
import { services } from '../../../data/services';

const title = buildTitle('Consulting Forester in Fallsburg, NY');
const description = buildDescription(
  'Consulting forester in Fallsburg, NY — serving South Fallsburg, Loch Sheldrake, Woodridge. Timber appraisals, 480-a, land clearing. (845) 754-8242.'
);
const canonicalUrl = buildCanonical('/locations/sullivan-county-ny/fallsburg');

const crumbs = [
  { label: 'Home',            href: '/' },
  { label: 'Locations',       href: '/locations' },
  { label: 'Sullivan County', href: '/locations/sullivan-county-ny' },
  { label: 'Fallsburg',       href: '/locations/sullivan-county-ny/fallsburg' },
];

const faqs = [
  {
    question: 'Does EFP serve landowners in Fallsburg Township, including South Fallsburg and Loch Sheldrake?',
    answer: 'Yes. Environmental Forest Products serves private landowners throughout Fallsburg Township — including the communities of South Fallsburg, Loch Sheldrake, Woodridge, and the broader township. Henry Kowalec has conducted timber appraisals, land clearing assessments, and 480-a consultations on properties across this range for more than 30 years. Call (845) 754-8242.',
  },
  {
    question: 'What type of forest is typical in the Fallsburg area?',
    answer: 'Fallsburg Township encompasses a wide range of land types. The denser development around South Fallsburg is surrounded by residential woodlots and transitional land. Moving north into the township, the woodland character becomes more substantial — mature mixed hardwood stands of red oak, red maple, black birch, and white pine on the forested slopes and ridges. The northern reaches of the township also contain significant abandoned agricultural land that has been reverting to second-growth forest for 20–40 years — stands that are now at a management-relevant age.',
  },
  {
    question: 'My property in South Fallsburg is partly wooded. Is a timber assessment worth doing?',
    answer: 'Yes, particularly if you are considering any clearing or development on the wooded portion. The Fallsburg corridor near Route 52 and Route 42 has active residential development pressure, and many properties have trees that should be assessed before clearing decisions are made. Red oak, red maple, and white pine on these sites can have market value that a general contractor will not identify or recover. A timber assessment before clearing begins determines what is present and whether a sale makes sense before the land is cleared.',
  },
  {
    question: 'Can Fallsburg Township landowners qualify for 480-a enrollment?',
    answer: 'Yes, if the property meets the 50-acre qualifying woodland threshold. Properties in the northern reaches of the township — away from the developed South Fallsburg corridor — often have the acreage and forest condition that supports 480-a enrollment. The second-growth stands in this area are increasingly old enough to qualify as productive woodland under DEC criteria. Henry Kowalec assesses eligibility during on-site visits and handles the full enrollment process.',
  },
  {
    question: 'Does EFP handle land clearing in the Fallsburg area?',
    answer: 'Yes. Land clearing for residential and commercial site preparation is part of EFP\'s service throughout Fallsburg and the surrounding Sullivan County corridor. The timber assessment before clearing is EFP\'s standard first step — determining whether merchantable trees are present and recovering that value through a sale before clearing begins. This step is particularly relevant in the South Fallsburg area where residential development activity is ongoing.',
  },
  {
    question: 'What communities within Fallsburg Township does EFP specifically serve?',
    answer: 'Environmental Forest Products serves landowners throughout the Town of Fallsburg, including South Fallsburg, Loch Sheldrake, Woodridge, and the rural portions of the township. Service is also available to neighboring communities including Monticello to the west, Liberty to the north, and Rock Hill to the south. The township boundaries are not the service boundary — EFP serves the entire Sullivan County region.',
  },
];
---

<LocationLayout title={title} description={description} canonicalUrl={canonicalUrl}>
  <ServiceSchema
    pageType="location"
    serviceName="Forestry Consulting — Fallsburg, NY"
    description={description}
    url={canonicalUrl}
    areaServed={['Fallsburg, NY', 'South Fallsburg, NY', 'Loch Sheldrake, NY', 'Woodridge, NY', 'Sullivan County, NY']}
    crumbs={crumbs}
  />
  <FAQSchema items={faqs} />
  <Breadcrumb crumbs={crumbs} />

  <PageHero
    title="Forestry Consulting in Fallsburg, NY"
    subtitle="Serving South Fallsburg, Loch Sheldrake, Woodridge, and all of Fallsburg Township"
  />

  <article class="max-w-4xl mx-auto my-8 sm:my-10 px-8 sm:px-12 py-10 bg-white rounded-2xl shadow-md ring-1 ring-gray-200">

    <KeyTakeaway
      text="Environmental Forest Products provides certified forestry consulting throughout Fallsburg Township, NY — from the South Fallsburg development corridor to the rural wooded parcels in the northern reaches of the township. Henry Kowalec offers on-site timber appraisals, 480-a Forest Tax Law enrollment, land clearing assessments, and woodland management for Fallsburg area landowners."
    />

    <AuthorByline />

    <h2 class="text-2xl font-bold text-[#1a3c1a] mt-10 mb-4">Fallsburg's Range — From Development Corridor to Rural Woodland</h2>

    <p class="text-gray-700 leading-relaxed mb-4">
      Fallsburg Township is one of Sullivan County's most internally varied municipalities. The southern portion of the township — South Fallsburg and the Route 52 corridor — is the county's most developed zone, with commercial and residential activity that generates regular demand for land clearing, timber assessment before site development, and stump and debris removal after tree work. The communities of Loch Sheldrake and Woodridge sit in the middle of the township with a more residential character and surrounding woodland that benefits from professional assessment.
    </p>
    <p class="text-gray-700 leading-relaxed mb-4">
      Moving north through the township, the land opens into more substantial forested tracts — mature woodlots on private parcels, and a significant inventory of former agricultural land that has been reverting to woodland for 20–40 years. These second-growth stands are reaching the age where the management decisions made now have long-term consequences for the forest's species composition, timber value, and eligibility for programs like <a href="/services/480a-forest-tax-law" class="text-[#2d5a2d] underline hover:text-[#1a3c1a]">480-a Forest Tax Law enrollment</a>.
    </p>

    <h2 class="text-2xl font-bold text-[#1a3c1a] mt-10 mb-4">Timber Before Clearing — What Fallsburg Landowners Often Miss</h2>

    <p class="text-gray-700 leading-relaxed mb-4">
      In the South Fallsburg corridor, where residential development activity is ongoing, EFP regularly conducts pre-clearing timber assessments for property owners who are preparing sites for construction. The typical scenario: a parcel has mature trees, a contractor is ready to clear, and the question is whether those trees have market value worth recovering before the chipper arrives.
    </p>
    <p class="text-gray-700 leading-relaxed mb-4">
      On many Fallsburg-area clearing sites, the answer is yes. Red oak, red maple, and white pine on residential lots can have stumpage value that covers a meaningful portion of the clearing cost if handled correctly. An <a href="/services/sell-standing-timber" class="text-[#2d5a2d] underline hover:text-[#1a3c1a]">independent timber assessment</a> before clearing begins is the step that determines whether that value exists and whether capturing it is practical. Most general contractors do not take this step — a consulting forester always will.
    </p>

    <h2 class="text-2xl font-bold text-[#1a3c1a] mt-10 mb-4">Forestry Services Near Fallsburg, South Fallsburg, and Loch Sheldrake</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-10">
      {services.map(svc => (
        <a
          href={`/services/${svc.slug}`}
          class="flex items-start gap-3 p-4 border border-gray-200 rounded-lg hover:border-[#2d5a2d] hover:bg-green-50 transition-colors group"
        >
          <span class="text-2xl flex-shrink-0" aria-hidden="true">{svc.icon}</span>
          <div>
            <div class="font-semibold text-[#1a3c1a] group-hover:text-[#2d5a2d] text-sm">{svc.name}</div>
            <div class="text-xs text-gray-500 mt-0.5 leading-snug">{svc.excerpt.split('—')[0].trim()}</div>
          </div>
        </a>
      ))}
    </div>

    <!-- Neighborhood sub-pages -->
    <div class="bg-gray-50 border border-gray-200 rounded-lg p-5 mb-10">
      <h3 class="font-semibold text-[#1a3c1a] mb-3 text-sm uppercase tracking-wide">Fallsburg Township Communities</h3>
      <div class="flex flex-wrap gap-3">
        <a href="/locations/sullivan-county-ny/fallsburg/south-fallsburg" class="text-sm text-[#2d5a2d] hover:underline">South Fallsburg</a>
        <a href="/locations/sullivan-county-ny/fallsburg/loch-sheldrake" class="text-sm text-[#2d5a2d] hover:underline">Loch Sheldrake</a>
      </div>
    </div>

    <div class="bg-[#1a3c1a] text-white rounded-lg p-6 my-10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <p class="font-bold text-lg mb-1">Schedule a Site Assessment in Fallsburg Township</p>
        <p class="text-green-200 text-sm">Henry walks the property — South Fallsburg, Loch Sheldrake, Woodridge, and all of Fallsburg.</p>
      </div>
      <a href="tel:+18454980208" class="inline-flex items-center gap-2 bg-white text-[#1a3c1a] font-bold px-5 py-3 rounded hover:bg-green-100 transition-colors text-sm whitespace-nowrap flex-shrink-0">
        <svg class="w-4 h-4" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20"><path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/></svg>
        (845) 754-8242
      </a>
    </div>

    <FAQSection items={faqs} />

    <div class="border border-gray-200 rounded-lg p-5 my-10">
      <h3 class="font-semibold text-[#1a3c1a] mb-3 text-sm uppercase tracking-wide">Nearby Sullivan County Communities</h3>
      <div class="flex flex-wrap gap-3">
        <a href="/locations/sullivan-county-ny/liberty" class="text-sm text-[#2d5a2d] hover:underline">Liberty</a>
        <a href="/locations/sullivan-county-ny/monticello" class="text-sm text-[#2d5a2d] hover:underline">Monticello</a>
        <a href="/locations/sullivan-county-ny/woodbourne" class="text-sm text-[#2d5a2d] hover:underline">Woodbourne</a>
        <a href="/locations/sullivan-county-ny/rock-hill" class="text-sm text-[#2d5a2d] hover:underline">Rock Hill</a>
        <a href="/locations/sullivan-county-ny" class="text-sm text-[#2d5a2d] hover:underline font-semibold">View all Sullivan County towns →</a>
      </div>
    </div>

    <EstimateForm variant="b2c" />
  </article>
</LocationLayout>
