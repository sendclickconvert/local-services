---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import EstimateForm from '../components/forms/EstimateForm.astro';
import { buildTitle, buildCanonical, buildDescription } from '../lib/seo';
import { business } from '../data/client.config';

const title  = buildTitle("Contact Henry Kowalec — Free Forestry Consultation");
const description = buildDescription(
  "Contact Environmental Forest Products for a free forestry consultation. " +
  "Serving Sullivan, Orange, and Ulster counties, NY. Call (845) 754-8242 or send a message."
);
const canonicalUrl = buildCanonical("/contact");

const crumbs = [
  { label: "Home",    href: "/" },
  { label: "Contact", href: "/contact" },
];
---

<BaseLayout title={title} description={description} canonicalUrl={canonicalUrl}>
  <Breadcrumb crumbs={crumbs} />

  <PageHero
    title="Contact Henry Kowalec"
    subtitle="Free consultation for landowners in Sullivan, Orange, and Ulster counties — no obligation"
  />

  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-10 mb-14">

      <!-- Contact info -->
      <div>
        <h2 class="text-xl font-bold text-[#1a3c1a] mb-5">Get in Touch</h2>

        <div class="space-y-5">
          <div class="flex items-start gap-3">
            <svg aria-hidden="true" class="w-5 h-5 text-[#2d5a2d] mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
            </svg>
            <div>
              <div class="text-xs text-gray-500 uppercase tracking-wide font-medium mb-0.5">Phone</div>
              <a href="tel:+18454980208" class="text-[#1a3c1a] font-bold text-lg hover:text-[#2d5a2d]">
                (845) 754-8242
              </a>
              <p class="text-xs text-gray-500 mt-0.5">Best way to reach Henry directly</p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <svg aria-hidden="true" class="w-5 h-5 text-[#2d5a2d] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <div>
              <div class="text-xs text-gray-500 uppercase tracking-wide font-medium mb-0.5">Email</div>
              <a href="mailto:henry@eforestproducts.com" class="text-[#1a3c1a] font-semibold hover:text-[#2d5a2d] break-all">
                henry@eforestproducts.com
              </a>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <svg aria-hidden="true" class="w-5 h-5 text-[#2d5a2d] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <div>
              <div class="text-xs text-gray-500 uppercase tracking-wide font-medium mb-0.5">Location</div>
              <div class="text-gray-700 text-sm">Westbrookville, NY 12785</div>
              <div class="text-xs text-gray-500 mt-0.5">Serving Sullivan, Orange, Ulster counties · Pike &amp; Wayne PA · Sussex NJ</div>
            </div>
          </div>
        </div>

        <!-- What to expect -->
        <div class="mt-8 bg-green-50 border border-green-200 rounded-lg p-5">
          <h3 class="font-semibold text-[#1a3c1a] text-sm mb-3">What to Expect</h3>
          <ul class="text-sm text-gray-700 space-y-2">
            <li class="flex gap-2"><span class="text-[#2d5a2d] font-bold flex-shrink-0">1.</span>Henry reviews your message or takes your call</li>
            <li class="flex gap-2"><span class="text-[#2d5a2d] font-bold flex-shrink-0">2.</span>Brief discussion about your property and goals</li>
            <li class="flex gap-2"><span class="text-[#2d5a2d] font-bold flex-shrink-0">3.</span>Site visit scheduled if your project is a fit</li>
            <li class="flex gap-2"><span class="text-[#2d5a2d] font-bold flex-shrink-0">4.</span>No obligation — site visits are free</li>
          </ul>
        </div>
      </div>

      <!-- Form -->
      <div>
        <h2 class="text-xl font-bold text-[#1a3c1a] mb-5">Send a Message</h2>
        <EstimateForm variant="b2c" compact={true} showPhone={false} />
      </div>
    </div>

    <!-- Service area reference -->
    <div class="border-t border-gray-200 pt-8">
      <h2 class="text-lg font-bold text-[#1a3c1a] mb-3">Service Area</h2>
      <p class="text-gray-600 text-sm leading-relaxed mb-4">
        Environmental Forest Products serves private woodland owners primarily in Sullivan, Orange, and Ulster
        counties in New York, with additional coverage in Pike and Wayne counties in Pennsylvania and Sussex
        County in New Jersey. Projects outside this area are considered on a case-by-case basis.
      </p>
      <a href="/locations" class="text-[#2d5a2d] text-sm font-semibold hover:underline">
        View all service areas →
      </a>
    </div>

  </section>
</BaseLayout>
