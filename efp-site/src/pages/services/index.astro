---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import ServiceCard from '../../components/ui/ServiceCard.astro';
import AuthorByline from '../../components/ui/AuthorByline.astro';
import KeyTakeaway from '../../components/ui/KeyTakeaway.astro';
import { buildTitle, buildCanonical, buildDescription } from '../../lib/seo';

const title = buildTitle("Forestry Services — Sullivan, Orange & Ulster Counties NY");
const description = buildDescription(
  "Certified forestry consulting services in the Hudson Valley and Catskills. 480-a Forest Tax Law enrollment, timber harvesting, land clearing, woodlot management, and more — led by Henry Kowalec with 30+ years of regional experience."
);
const canonicalUrl = buildCanonical("/services");
---

<ServiceLayout title={title} description={description} canonicalUrl={canonicalUrl}>
  <PageHero
    title="Forestry Consulting Services"
    subtitle="480-a Forest Tax Law · Timber Harvesting · Land Clearing · Woodlot Management — Sullivan, Orange, and Ulster counties"
    bgImage="/images/uploads/komatsu-feller-buncher-timber-harvest-1-ny.jpg"
    bgImageAlt="Komatsu feller buncher working a timber harvest in New York"
  />

  <article class="max-w-4xl mx-auto my-8 sm:my-10 px-8 sm:px-12 py-10 bg-white rounded-2xl shadow-md ring-1 ring-gray-200">

    <KeyTakeaway text="Every EFP engagement starts with an on-site assessment — not a phone estimate. Henry Kowalec walks your property personally before any scope is set, any recommendation is made, or any work is scheduled. That direct approach is what 30+ years of regional forestry experience looks like in practice." />

    <AuthorByline />
    <p class="text-xs text-gray-400 mt-1 mb-8">Last reviewed: April 2026 by Henry Kowalec, CF</p>

    <h2 class="text-2xl font-bold text-[#1a3c1a] mt-2 mb-4">Forestry Services for Private Landowners and Commercial Clients</h2>
    <p class="text-gray-700 leading-relaxed mb-4">
      Environmental Forest Products provides certified forestry consulting across Sullivan, Orange, and Ulster counties in New York, plus Pike and Wayne counties in Pennsylvania and Sussex County in New Jersey. Every service is led by Henry Kowalec — a consulting forester with more than 30 years of hands-on experience in this specific region.
    </p>
    <p class="text-gray-700 leading-relaxed mb-4">
      The firm's work ranges from New York's 480-a Forest Tax Law program — where Henry is one of a small number of foresters in the region certified to write the required DEC-approved management plans — to timber harvesting, land clearing, woodlot management, wildlife habitat improvement, and residential tree work. The common thread across all of these services is that every decision is grounded in what Henry actually observes on your property, not in a general estimate or a phone conversation.
    </p>
    <p class="text-gray-700 leading-relaxed mb-10">
      Whether you own 10 acres or 1,000, the starting point is the same: a site assessment that tells you what you are working with, what your options are, and what any given course of action is actually worth pursuing. From there, the work is yours to direct.
    </p>

    <h2 class="text-2xl font-bold text-[#1a3c1a] mb-6">All Services</h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-2 gap-6 mb-12">
      <ServiceCard title="480-a Forest Tax Law" slug="480a-forest-tax-law" excerpt="Reduce your property taxes with NY's 480-a Forest Tax Law program. Henry is one of a small number of certified foresters in the region qualified to write the required management plans." photo="/images/uploads/stock/480a-forest-tax-law.jpg" photoAlt="Standing hardwood forest in autumn colour — the kind of wooded acreage that qualifies for New York 480-a Forest Tax Law enrollment" />
      <ServiceCard title="Land Clearing" slug="land-clearing" excerpt="Residential and commercial site preparation across Sullivan, Orange, and Ulster counties — clearing expertise grounded in forestry, not just excavation." photo="/images/uploads/land-clearing-forestburgh-ny-komatsu.jpg" photoAlt="Two Komatsu excavators clearing land at a project site in Forestburgh, NY, with an Environmental Forest Products crew member on the ground" photoClass="object-[center_40%]" />
      <ServiceCard title="Timber Harvesting" slug="timber-harvesting" excerpt="Selective, sustainable logging services. A consulting forester plans and oversees every harvest to protect your woodland and maximize what the timber is worth." photo="/images/uploads/komatsu-feller-buncher-selective-harvest-ny.jpg" photoAlt="Komatsu tracked feller buncher with felling head during a selective timber harvest in New York — marked trees only, surrounding stand left standing" photoClass="object-[center_35%]" />
      <ServiceCard title="Sell Standing Timber" slug="sell-standing-timber" excerpt="Timber appraisal, competitive bidding, and sale management. Find out what your timber is actually worth before you accept any offer." photo="/images/uploads/log-trucks-timber-export-hudson-valley-ny.jpg" photoAlt="Log trucks loaded with hardwood timber staged for export in the Hudson Valley, NY" photoClass="object-[center_48%]" />
      <ServiceCard title="Woodlot Management" slug="woodlot-management" excerpt="Forest management plans for private landowners — required for 480-a enrollment and the foundation of any long-term woodland stewardship program." photo="/images/uploads/timberjack-forwarder-nyc-dep-carmel-ny.jpg" photoAlt="Timberjack 1010B forwarder handling large hardwood logs on an NYC DEP forestry project in Carmel, NY" photoClass="object-[center_36%]" />
      <ServiceCard title="Wildlife Habitat" slug="wildlife-habitat-management" excerpt="Targeted forestry practices that improve habitat for deer, turkey, grouse, and native wildlife — fully compatible with 480-a and timber objectives." photo="/images/uploads/stock/wildlife-habitat.jpg" photoAlt="White-tailed deer buck moving through an autumn hardwood forest" />
      <ServiceCard title="Forest Stewardship Planning" slug="forest-stewardship-planning" excerpt="Comprehensive stewardship planning for private woodland owners — goals-based forest management beyond the 480-a compliance framework." photo="/images/uploads/stock/forest-stewardship-planning.jpg" photoAlt="Pathway winding through a mixed deciduous woodland in autumn" />
      <ServiceCard title="Emerald Ash Borer" slug="emerald-ash-borer" excerpt="Identification, treatment options, and salvage timber strategies for ash trees threatened by emerald ash borer in the Hudson Valley and Catskills." photo="/images/uploads/stock/emerald-ash-borer.jpg" photoAlt="Standing dead hardwood snags with broken tops among living summer foliage in a Northeastern woodland" />
      <ServiceCard title="Hemlock Woolly Adelgid" slug="hemlock-woolly-adelgid" excerpt="Assessment and treatment guidance for eastern hemlocks under threat from hemlock woolly adelgid — before decline advances past the point of recovery." photo="/images/uploads/stock/hemlock-woolly-adelgid.jpg" photoAlt="Eastern hemlock branches showing the short flat needles and small pendant cones typical of the species" />
      <ServiceCard title="Stump Grinding" slug="stump-grinding" excerpt="Complete stump removal after tree work, land clearing, or timber harvesting — leaving the site clean and ready for its next use." photo="/images/uploads/stock/stump-grinding.jpg" photoAlt="Freshly cut tree stump showing growth rings at ground level in a wooded area" />
      <ServiceCard title="Tree Planting" slug="tree-planting" excerpt="Native species selection, site preparation, and reforestation guidance for New York woodland." photo="/images/uploads/stock/tree-planting.jpg" photoAlt="Young conifer saplings established in open ground during reforestation" />
      <ServiceCard title="Tree Removal" slug="tree-removal" excerpt="Safe removal of hazard trees, storm-damaged trees, and diseased timber — any size or species." photo="/images/uploads/hand-felling-trees-nyc-dep-carmel-ny.jpg" photoAlt="Forester hand-felling a tree with a chainsaw beside a skidder on an NYC DEP timber project in Carmel, NY" photoClass="object-[center_46%]" />
    </div>

    <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 mb-8">
      <h3 class="font-bold text-[#1a3c1a] text-base mb-3">Free Interactive Tools</h3>
      <p class="text-gray-600 text-sm mb-4">Estimate costs and savings before your first call. These tools use regional pricing and forestry benchmarks for the Hudson Valley and Catskills.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <a href="/services/480a-forest-tax-law/480a-savings-calculator" class="flex items-center gap-3 p-3 bg-white border border-gray-200 rounded-lg hover:border-[#2d5a2d] hover:bg-green-50 transition-colors group">
          <svg class="w-6 h-6 flex-shrink-0 text-[#2d5a2d]" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="2.5" width="16" height="19" rx="2"/><rect x="7" y="5.5" width="10" height="3.5" rx="0.5"/><path stroke-linecap="round" d="M7.5 13h.01M12 13h.01M16.5 13h.01M7.5 17h.01M12 17h.01M16.5 17v0"/><path stroke-linecap="round" d="M16.5 16v2.5"/></svg>
          <div>
            <div class="font-semibold text-[#1a3c1a] text-sm group-hover:text-[#2d5a2d]">480-a Tax Savings Calculator</div>
            <div class="text-xs text-gray-500">Estimate annual property and school tax savings</div>
          </div>
        </a>
        <a href="/services/sell-standing-timber/timber-value-estimator" class="flex items-center gap-3 p-3 bg-white border border-gray-200 rounded-lg hover:border-[#2d5a2d] hover:bg-green-50 transition-colors group">
          <svg class="w-6 h-6 flex-shrink-0 text-[#2d5a2d]" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-5.5"/><path stroke-linejoin="round" d="M12 2.5c3.6 0 5.4 2.3 5.4 4.4 1.6.5 2.6 1.9 2.6 3.5 0 2.1-1.8 3.8-4 3.8H8c-2.2 0-4-1.7-4-3.8 0-1.6 1-3 2.6-3.5C6.6 4.8 8.4 2.5 12 2.5z"/></svg>
          <div>
            <div class="font-semibold text-[#1a3c1a] text-sm group-hover:text-[#2d5a2d]">Timber Value Estimator</div>
            <div class="text-xs text-gray-500">Estimate stumpage value by species and diameter</div>
          </div>
        </a>
        <a href="/services/tree-removal/tree-removal-cost-calculator" class="flex items-center gap-3 p-3 bg-white border border-gray-200 rounded-lg hover:border-[#2d5a2d] hover:bg-green-50 transition-colors group">
          <svg class="w-6 h-6 flex-shrink-0 text-[#2d5a2d]" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 3.5 9 8l2.5 2.5 4.5-4.5a3.2 3.2 0 0 0-2.5-2.5z"/><path stroke-linecap="round" d="m10.2 9.3-6.4 6.4a1.6 1.6 0 0 0 0 2.3l2.2 2.2a1.6 1.6 0 0 0 2.3 0l6.4-6.4"/></svg>
          <div>
            <div class="font-semibold text-[#1a3c1a] text-sm group-hover:text-[#2d5a2d]">Tree Removal Cost Calculator</div>
            <div class="text-xs text-gray-500">Local price range by size, species, and access</div>
          </div>
        </a>
        <a href="/services/land-clearing/land-clearing-cost-calculator" class="flex items-center gap-3 p-3 bg-white border border-gray-200 rounded-lg hover:border-[#2d5a2d] hover:bg-green-50 transition-colors group">
          <svg class="w-6 h-6 flex-shrink-0 text-[#2d5a2d]" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M3 19.5h18"/><path stroke-linejoin="round" d="M5 16.5V12h6l2.5 4.5"/><path stroke-linecap="round" stroke-linejoin="round" d="M16 16.5V9.5h3.5V16.5"/><path stroke-linecap="round" d="M8 12V9"/></svg>
          <div>
            <div class="font-semibold text-[#1a3c1a] text-sm group-hover:text-[#2d5a2d]">Land Clearing Cost Calculator</div>
            <div class="text-xs text-gray-500">Per-acre estimates by density, terrain, and disposal</div>
          </div>
        </a>
      </div>
    </div>

    <div class="mt-4 pt-6 border-t border-gray-200">
      <p class="text-xs font-semibold uppercase tracking-widest text-gray-400 mb-2">Service Area</p>
      <p class="text-sm text-gray-600 leading-relaxed">
        All services are available in <a href="/locations/sullivan-county-ny" class="text-[#2d5a2d] underline hover:text-[#1a3c1a]">Sullivan County</a>, <a href="/locations/orange-county-ny" class="text-[#2d5a2d] underline hover:text-[#1a3c1a]">Orange County</a>, and <a href="/locations/ulster-county-ny" class="text-[#2d5a2d] underline hover:text-[#1a3c1a]">Ulster County</a>, NY. Select services are available in Pike and Wayne counties, PA and Sussex County, NJ. Call <a href="tel:+18454980208" class="text-[#2d5a2d] font-semibold">(845) 754-8242</a> to confirm availability for your location.
      </p>
    </div>

  </article>

</ServiceLayout>
