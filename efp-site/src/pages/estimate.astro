---
// pages/estimate.astro — Primary conversion page
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/ui/CTASection.astro';
import EstimateForm from '../components/forms/EstimateForm.astro';
import { buildTitle, buildCanonical, buildDescription } from '../lib/seo';
import { business, phone } from '../data/client.config';

const title = buildTitle("Get a Free Estimate");
const description = buildDescription(
  "Request a free forestry consultation from Environmental Forest Products. " +
  "Timber appraisals, land clearing, 480-a management plans, and woodlot assessments across Sullivan, Orange, and Ulster counties, NY. Call (845) 754-8242."
);
const canonicalUrl = buildCanonical("/estimate");
---

<BaseLayout title={title} description={description} canonicalUrl={canonicalUrl}>

  <!-- Hero -->
  <section class="bg-[#1a3c1a] text-white py-16 sm:py-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-3xl sm:text-4xl font-bold mb-4">Request a Free Property Assessment</h1>
      <p class="text-green-200 text-lg mb-8 leading-relaxed">
        Henry Kowalec walks your property in person — no phone estimates, no guesswork.
        Fill out the form below or call directly at&nbsp;
        <a href={`tel:${phone.trackingTel}`} class="text-white font-semibold underline hover:text-green-200">
          {business.phone}
        </a>.
      </p>

      <!-- Trust pills -->
      <div class="flex flex-wrap justify-center gap-3 text-sm">
        {[
          "Free on-site assessment",
          "30+ years experience",
          "No obligation",
          "Certified consulting forester",
        ].map(t => (
          <span class="bg-white/10 border border-white/20 rounded-full px-4 py-1.5 text-green-100">{t}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- Main content -->
  <section class="py-14 sm:py-20 bg-gray-50">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">

      <!-- Left: form -->
      <div>
        <EstimateForm variant="b2c" id="estimate-form" />
      </div>

      <!-- Right: what to expect -->
      <div class="lg:pt-4">
        <h2 class="text-xl font-bold text-[#1a3c1a] mb-5">What Happens After You Submit</h2>
        <ol class="space-y-5">
          {[
            {
              step: "1",
              heading: "Henry reviews your request",
              body: "Every inquiry is reviewed personally by Henry Kowalec — not routed through a call center. He will follow up within one business day.",
            },
            {
              step: "2",
              heading: "We schedule a site visit",
              body: "Henry visits the property to assess actual conditions — species composition, timber volume, terrain, and your goals. There is no charge for the initial site visit.",
            },
            {
              step: "3",
              heading: "You receive a clear, written proposal",
              body: "Following the site visit, you receive a written proposal outlining the recommended scope of work, timeline, and pricing. No pressure, no surprises.",
            },
          ].map(item => (
            <li class="flex gap-4">
              <div class="flex-shrink-0 w-8 h-8 rounded-full bg-[#1a3c1a] text-white flex items-center justify-center font-bold text-sm">
                {item.step}
              </div>
              <div>
                <p class="font-semibold text-[#1a3c1a] mb-1">{item.heading}</p>
                <p class="text-gray-600 text-sm leading-relaxed">{item.body}</p>
              </div>
            </li>
          ))}
        </ol>

        <div class="mt-10 bg-white border border-gray-200 rounded-xl p-6 shadow-sm">
          <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3">Common Assessment Types</p>
          <ul class="space-y-2 text-sm text-gray-700">
            {[
              "Timber appraisal and stumpage valuation",
              "480-a Forest Tax Law eligibility review",
              "Land clearing cost estimate",
              "Woodlot management plan scoping",
              "Wildlife habitat improvement consultation",
              "Stump grinding or tree removal estimate",
            ].map(item => (
              <li class="flex items-start gap-2">
                <svg aria-hidden="true" class="w-4 h-4 text-[#2d5a2d] mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <div class="mt-8 text-center">
          <p class="text-sm text-gray-500 mb-2">Prefer to call directly?</p>
          <a href={`tel:${phone.trackingTel}`} class="text-[#2d5a2d] font-bold text-lg hover:text-[#1a3c1a]">
            {business.phone}
          </a>
        </div>
      </div>
    </div>
  </section>

  <CTASection variant="b2c" />
</BaseLayout>
