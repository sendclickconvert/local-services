---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import CTASection from '../../components/ui/CTASection.astro';
import AuthorByline from '../../components/ui/AuthorByline.astro';
import KeyTakeaway from '../../components/ui/KeyTakeaway.astro';
import { getCollection } from 'astro:content';
import { buildTitle, buildCanonical, buildDescription } from '../../lib/seo';

const title = buildTitle("Forestry & Land Management Guides — NY Woodland Owner Resources");
const description = buildDescription(
  "Free guides for New York woodland owners. Timber harvesting, land clearing costs, 480-a Forest Tax Law, " +
  "selective cutting, forestry mulching, and woodland management — written by a certified consulting forester."
);
const canonicalUrl = buildCanonical("/guides");

const allGuides = await getCollection('guides');
const standaloneGuides = [
  { slug: "should-i-sell-my-timber", title: "Should I Sell My Timber? What NY Landowners Need to Know", description: "Before you negotiate with a logger, read this. Timber appraisal, competitive bidding, and why independent assessment matters." },
  { slug: "what-is-a-forest-management-plan", title: "What Is a Forest Management Plan?", description: "What a plan includes, who can write one for 480-a enrollment, and why private woodland owners need one." },
];
const pillar = allGuides.find(g => g.data.isPillar);
const spokes = allGuides.filter(g => !g.data.isPillar).sort((a, b) =>
  a.data.title.localeCompare(b.data.title)
);
---

<BaseLayout title={title} description={description} canonicalUrl={canonicalUrl}>
  <PageHero
    title="Forestry & Land Management Guides"
    subtitle="Practical guides for NY woodland owners — timber value, land clearing, forest tax programs, and more"
    bgImage="/images/uploads/stock/hero-forest-path.jpg"
    bgImageAlt="Misty forest road at dawn"
  />

  <section class="py-12 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="bg-white rounded-2xl shadow-md ring-1 ring-gray-200 px-8 sm:px-12 py-10 mb-10">
        <KeyTakeaway text="These guides are written for private woodland owners in Sullivan, Orange, and Ulster counties — not general forestry overviews. Every one is based on what Henry Kowalec actually sees on properties in this region and the questions landowners ask before and after their first site visit." />

        <AuthorByline />
        <p class="text-xs text-gray-400 mt-1 mb-8">All guides reviewed April 2026 by Henry Kowalec, CF</p>

        <p class="text-gray-700 leading-relaxed mb-4">
          The questions private landowners ask before calling a forester are usually the same questions — and they are good ones. What is my timber actually worth? What does land clearing cost per acre in New York? How does the 480-a Forest Tax Law work, and do I qualify? What is a forest management plan, and do I need one?
        </p>
        <p class="text-gray-700 leading-relaxed mb-4">
          These guides answer those questions with the specificity that the Hudson Valley and Catskills region actually requires. General forestry information is available everywhere. What is harder to find is a clear explanation of what that information means for a 75-acre mixed hardwood woodlot in Sullivan County, or a cleared parcel in Orange County that a developer wants to assess before equipment arrives.
        </p>
        <p class="text-gray-700 leading-relaxed">
          Read whichever guide is relevant to where you are right now. If it raises more questions than it answers, the next step is a site visit — and that starts with a call to <a href="tel:+18454980208" class="text-[#2d5a2d] font-semibold">(845) 754-8242</a>.
        </p>
      </div>

      {pillar && (
        <div class="bg-green-50 border-2 border-[#2d5a2d] rounded-xl p-6 mb-10">
          <p class="text-xs font-bold uppercase tracking-wider text-[#2d5a2d] mb-2">Complete Guide</p>
          <h2 class="text-2xl font-bold text-[#1a3c1a] mb-2">
            <a href={`/guides/${pillar.slug}`} class="hover:text-[#2d5a2d] transition-colors">
              {pillar.data.title}
            </a>
          </h2>
          <p class="text-gray-600 mb-4 leading-relaxed">{pillar.data.description}</p>
          <a href={`/guides/${pillar.slug}`} class="inline-flex items-center gap-1 font-semibold text-[#2d5a2d] hover:text-[#1a3c1a] transition-colors">
            Read the complete guide
            <svg class="w-4 h-4" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </a>
        </div>
      )}

      {spokes.length > 0 && (
        <div class="mb-10">
          <h2 class="text-xl font-bold text-[#1a3c1a] mb-6">In This Series</h2>
          <ul class="divide-y divide-gray-100 bg-white rounded-xl shadow-sm ring-1 ring-gray-100 overflow-hidden">
            {spokes.map(guide => (
              <li class="py-5 px-5 hover:bg-green-50 transition-colors">
                <a href={`/guides/${guide.slug}`} class="block font-semibold text-[#1a3c1a] hover:text-[#2d5a2d] transition-colors mb-1">
                  {guide.data.title}
                </a>
                <p class="text-sm text-gray-500 leading-relaxed">{guide.data.description}</p>
              </li>
            ))}
          </ul>
        </div>
      )}

      {standaloneGuides.length > 0 && (
        <div class="mb-10">
          <h2 class="text-xl font-bold text-[#1a3c1a] mb-6">More Guides</h2>
          <ul class="divide-y divide-gray-100 bg-white rounded-xl shadow-sm ring-1 ring-gray-100 overflow-hidden">
            {standaloneGuides.map(guide => (
              <li class="py-5 px-5 hover:bg-green-50 transition-colors">
                <a href={`/guides/${guide.slug}`} class="block font-semibold text-[#1a3c1a] hover:text-[#2d5a2d] transition-colors mb-1">
                  {guide.title}
                </a>
                <p class="text-sm text-gray-500 leading-relaxed">{guide.description}</p>
              </li>
            ))}
          </ul>
        </div>
      )}

    </div>
  </section>

  <CTASection variant="b2c" />
</BaseLayout>
