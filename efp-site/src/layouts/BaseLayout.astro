---
// BaseLayout.astro
// Master layout: <head> + Header + main slot + Footer.
// All other layouts extend this one.
//
// SCHEMA DOCTRINE:
//   LocalBusiness schema → homepage ONLY (injected directly in index.astro)
//   All other pages → Service/Article/FAQ schemas reference org by @id only
//   BaseLayout does NOT inject org schema — that is intentional per blueprint.

import BaseHead from '../components/layout/BaseHead.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import ChatWidget from '../components/ChatWidget.astro';

interface Props {
  title: string;
  description?: string;
  canonicalUrl: string;   // Always from buildCanonical() in src/lib/seo.ts
  ogImage?: string;       // Always from buildOgImage() — absolute URL
  robotsContent?: string; // From noindex() — undefined means no robots tag rendered
  ogType?: string;        // "website" (default) or "article" for guide pages
  suppressChatWidget?: boolean; // Set true on pages with phone-collecting forms (A2P: one opt-in source per page)
}

const {
  title,
  description,
  canonicalUrl,
  ogImage,
  robotsContent,
  ogType,
  suppressChatWidget = false,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <BaseHead
    title={title}
    description={description}
    canonicalUrl={canonicalUrl}
    ogImage={ogImage}
    robotsContent={robotsContent}
    ogType={ogType}
  />
</head>
<body>
  <Header currentPath={Astro.url.pathname} />
  <main class="bg-gray-50">
    <slot />
  </main>
  <Footer />
  {!suppressChatWidget && <ChatWidget />}
</body>
</html>
