---
// ArticleSchema.astro
// Injects BlogPosting + BreadcrumbList JSON-LD for all /guides/ articles.
//
// ─── RULES ────────────────────────────────────────────────────────────────────
// • image array MUST include all three aspect ratios before publish:
//   16:9, 4:3, 1:1 — required for Google rich results eligibility.
//   Use buildSchemaImages(slug) from src/lib/seo.ts to generate.
//
// • dateModified MUST be updated on every content edit — freshness signal.
//
// • BreadcrumbList is emitted as a SEPARATE top-level <script> block.
//   It must NOT be nested inside BlogPosting — invalid JSON-LD when done that
//   way and prevents breadcrumb rich results from firing.
//
// • publisher uses @id reference to the org node (defined on homepage).
//   Do NOT inline the full Organization object here.
//
// • author includes @id, url, and hasCredential for E-E-A-T signals.
// ─────────────────────────────────────────────────────────────────────────────

import { author, business } from '../../data/client.config';
import { buildBreadcrumbs } from '../../data/schema/breadcrumbs';
import type { Crumb } from '../../data/schema/breadcrumbs';

interface Props {
  title: string;
  description: string;
  url: string;
  datePublished: string;
  dateModified: string;
  images: string[];     // Use buildSchemaImages(slug) — must be 3 items
  crumbs: Crumb[];      // Same array passed to Breadcrumb.astro
}

const { title, description, url, datePublished, dateModified, images, crumbs } = Astro.props;

// ─── 1. BlogPosting schema ────────────────────────────────────────────────────
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": url,
  "headline": title,
  "description": description,
  "url": url,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": url,
  },
  "datePublished": datePublished,
  "dateModified": dateModified,
  "image": images,
  "author": {
    "@type": "Person",
    "@id": `${business.domain}/#henry-kowalec`,
    "name": author.name,
    "jobTitle": "Certified Consulting Forester",
    "url": `${business.domain}/about`,
    "hasCredential": {
      "@type": "EducationalOccupationalCredential",
      "credentialCategory": "professional certification",
      "name": "Certified Forester (CF), Society of American Foresters",
    },
    "sameAs": [...author.sameAs],
  },
  "publisher": {
    "@id": `${business.domain}/#organization`,
  },
};

// ─── 2. BreadcrumbList — standalone top-level block ──────────────────────────
// buildBreadcrumbs() already includes "@context" — emit as its own <script> tag.
const breadcrumbSchema = buildBreadcrumbs(crumbs);
---

<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
