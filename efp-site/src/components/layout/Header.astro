---
// Header.astro
// Sticky nav: logo left, 480-a badge, primary links, click-to-call right.
// Mobile: hamburger toggle via inline script only.

import { business, phone } from '../../data/client.config';

interface Props {
  currentPath: string;
}
const { currentPath } = Astro.props;

// 480-a keeps the "480-a Certified" badge below, the footer link, the homepage
// service card, and its slot on /services — it is de-emphasised here only.
const navLinks = [
  { label: 'Land Clearing',     href: '/services/land-clearing' },
  { label: 'Services',          href: '/services'  },
  { label: 'Service Locations', href: '/locations' },
  { label: 'Gallery',           href: '/gallery'   },
  { label: 'About',             href: '/about'     },
  { label: 'Contact',           href: '/contact'   },
];

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="sticky top-0 z-50 bg-white shadow-md border-b border-gray-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">

      <div class="flex items-center gap-3 flex-shrink-0">
        <a href="/" class="flex items-center group" aria-label="Environmental Forest Products — Home">
          <img
            src="/images/logos/efp-logo.webp"
            alt="Environmental Forest Products"
            class="h-9 sm:h-10 w-auto"
            width="300" height="54"
          />
        </a>

        <a
          href="/services/480a-forest-tax-law"
          class="hidden lg:inline-flex items-center gap-1.5 bg-[#1a3c1a] text-white text-xs font-semibold px-3 py-1.5 rounded-full hover:bg-[#2d5a2d] transition-colors"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
          </svg>
          480-a Certified
        </a>
      </div>

      <nav class="hidden md:flex items-center gap-1" aria-label="Main navigation">
        {navLinks.map(link => (
          <a
            href={link.href}
            class={`px-3 py-2 rounded text-sm font-medium transition-colors ${
              isActive(link.href)
                ? 'bg-[#1a3c1a] text-white'
                : 'text-gray-700 hover:text-[#1a3c1a] hover:bg-gray-100'
            }`}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-2">

        <!-- Facebook deliberately omitted here — an off-site link in the highest-value
             position on the page. It lives in the footer instead. -->

        <a
          href={`tel:${phone.trackingTel}`}
          class="flex items-center gap-2 bg-[#1a3c1a] hover:bg-[#2d5a2d] text-white text-sm font-semibold px-4 py-2 rounded-full transition-colors"
          aria-label={`Call ${phone.display}`}
        >
          <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
          </svg>
          <span class="hidden sm:inline">{phone.display}</span>
          <span class="sm:hidden">Call</span>
        </a>

        <button
          id="mobile-menu-toggle"
          class="md:hidden text-gray-700 hover:text-[#1a3c1a] p-2 rounded transition-colors"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Toggle navigation menu"
        >
          <svg id="icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg id="icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

    </div>
  </div>

  <div id="mobile-menu" class="hidden md:hidden bg-white border-t border-gray-100">
    <nav class="max-w-7xl mx-auto px-4 py-3 flex flex-col gap-1" aria-label="Mobile navigation">
      {navLinks.map(link => (
        <a
          href={link.href}
          class={`px-3 py-3 rounded text-sm font-medium transition-colors ${
            isActive(link.href)
              ? 'bg-[#1a3c1a] text-white'
              : 'text-gray-700 hover:text-[#1a3c1a] hover:bg-gray-100'
          }`}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu   = document.getElementById('mobile-menu');
  const iconOpen  = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');
  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(isOpen));
    iconOpen?.classList.toggle('hidden', isOpen);
    iconClose?.classList.toggle('hidden', !isOpen);
  });
</script>
