---
// ClusterArticles.astro
// Displays all cluster articles belonging to a service pillar.
// Drop into any service page: <ClusterArticles serviceSlug="tree-removal" />
// Renders nothing if no articles exist for the service.

import { getCollection } from 'astro:content';

interface Props {
  serviceSlug: string;
  heading?: string;
}

const { serviceSlug, heading = "Related Guides" } = Astro.props;

const all = await getCollection('articles');
const articles = all
  .filter(a => a.data.service === serviceSlug && !a.data.noindex)
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
---

{articles.length > 0 && (
  <div class="mt-12 border-t border-gray-200 pt-10">
    <h2 class="text-2xl font-bold text-[#1a3c1a] mb-2">{heading}</h2>
    <p class="text-gray-600 text-sm mb-6">Deep-dive articles on this topic — keyword-researched, written by Henry Kowalec.</p>
    <ul class="space-y-3">
      {articles.map(article => (
        <li>
          <a
            href={`/services/${serviceSlug}/${article.slug}`}
            class="group flex items-start gap-3 p-4 rounded-lg border border-gray-200 hover:border-[#2d5a2d] hover:bg-green-50 transition-colors"
          >
            <svg aria-hidden="true" class="w-5 h-5 text-[#2d5a2d] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            <div class="min-w-0">
              <span class="font-semibold text-[#1a3c1a] group-hover:text-[#2d5a2d] block leading-snug">{article.data.title}</span>
              {article.data.description && (
                <span class="text-gray-500 text-sm mt-0.5 block line-clamp-2">{article.data.description}</span>
              )}
            </div>
            <svg aria-hidden="true" class="w-4 h-4 text-gray-400 group-hover:text-[#2d5a2d] flex-shrink-0 mt-1 ml-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </li>
      ))}
    </ul>
  </div>
)}
