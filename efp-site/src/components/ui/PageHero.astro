---
// PageHero.astro
// Full-width hero: H1, subtitle, CTA button.
// Renders cleanly with or without a background image.
// With bgImage: dark overlay for text legibility.
// Without bgImage: solid forest green band.

import { business } from '../../data/client.config';

interface Props {
  title: string;
  subtitle?: string;
  ctaLabel?: string;
  ctaHref?: string;
  bgImage?: string;
}

const {
  title,
  subtitle,
  ctaLabel = 'Call for a Free Consultation',
  ctaHref  = `tel:${business.phoneRaw}`,
  bgImage,
} = Astro.props;
---

<section
  class={`relative py-20 sm:py-28 ${bgImage ? 'bg-cover bg-center bg-no-repeat' : 'bg-[#1a3c1a]'}`}
  style={bgImage ? `background-image: url('${bgImage}');` : ''}
>
  {/* Dark overlay when image is present */}
  {bgImage && (
    <div class="absolute inset-0 bg-[#0d1a0d]/70" aria-hidden="true" />
  )}

  <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white leading-tight mb-5">
      {title}
    </h1>

    {subtitle && (
      <p class="text-lg sm:text-xl text-green-200 mb-8 max-w-2xl mx-auto leading-relaxed">
        {subtitle}
      </p>
    )}

    <a
      href={ctaHref}
      class="inline-flex items-center gap-2 bg-white text-[#1a3c1a] hover:bg-green-50 font-bold text-base sm:text-lg px-8 py-4 rounded shadow-lg transition-colors"
    >
      {ctaHref.startsWith('tel:') && (
        <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
        </svg>
      )}
      {ctaLabel}
    </a>
  </div>
</section>
