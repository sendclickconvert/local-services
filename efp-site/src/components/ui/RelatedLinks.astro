---
// RelatedLinks.astro
// Hub/spoke internal link block. Renders at bottom of guide articles and service pages.
// Drives topical authority and distributes PageRank through the content cluster.

interface LinkItem {
  label: string;
  href: string;
}
interface Props {
  upLinks?: LinkItem[];
  downLinks?: LinkItem[];
  serviceLinks?: LinkItem[];
  locationLinks?: LinkItem[];
}
const { upLinks = [], downLinks = [], serviceLinks = [], locationLinks = [] } = Astro.props;
const hasContent = upLinks.length + downLinks.length + serviceLinks.length + locationLinks.length > 0;
---

{hasContent && (
  <aside class="bg-green-50 border border-green-200 rounded-lg p-6 mt-12">
    <h3 class="text-sm font-bold uppercase tracking-wider text-[#2d5a2d] mb-5">Related Resources</h3>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">

      {upLinks.length > 0 && (
        <div>
          <p class="text-xs text-gray-500 uppercase tracking-wide font-medium mb-2">Complete Guide</p>
          <ul class="space-y-2">
            {upLinks.map(link => (
              <li>
                <a href={link.href} class="flex items-center gap-2 text-sm text-[#1a3c1a] font-medium hover:text-[#2d5a2d] transition-colors">
                  <svg class="w-4 h-4 text-[#2d5a2d] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"/></svg>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      {downLinks.length > 0 && (
        <div>
          <p class="text-xs text-gray-500 uppercase tracking-wide font-medium mb-2">In This Series</p>
          <ul class="space-y-2">
            {downLinks.map(link => (
              <li>
                <a href={link.href} class="flex items-center gap-2 text-sm text-[#1a3c1a] hover:text-[#2d5a2d] transition-colors">
                  <svg class="w-4 h-4 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      {serviceLinks.length > 0 && (
        <div>
          <p class="text-xs text-gray-500 uppercase tracking-wide font-medium mb-2">Our Services</p>
          <ul class="space-y-2">
            {serviceLinks.map(link => (
              <li>
                <a href={link.href} class="flex items-center gap-2 text-sm text-[#1a3c1a] hover:text-[#2d5a2d] transition-colors">
                  <svg class="w-4 h-4 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      {locationLinks.length > 0 && (
        <div>
          <p class="text-xs text-gray-500 uppercase tracking-wide font-medium mb-2">Service Areas</p>
          <ul class="space-y-2">
            {locationLinks.map(link => (
              <li>
                <a href={link.href} class="flex items-center gap-2 text-sm text-[#1a3c1a] hover:text-[#2d5a2d] transition-colors">
                  <svg class="w-4 h-4 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/></svg>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

    </div>
  </aside>
)}
