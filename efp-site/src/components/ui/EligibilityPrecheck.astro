---
// EligibilityPrecheck.astro
// 480-a Forest Tax Law Eligibility Pre-Check — lightweight screening tool
// Primary placement: /services/480a-forest-tax-law
// Secondary: NY county pages (Sullivan, Orange, Ulster, etc.)
//
// Logic produces 3 result states:
//   A — Likely good candidate
//   B — Possible candidate, needs review
//   C — Probably not a current fit
//
// CONTENT RULES:
//   - This is NOT legal or tax advice. Disclaimer must be visible on every result.
//   - Factual, neutral tone. No savings promises.
//   - Result displayed inline — no page reload.
//   - Do not touch schema files, form endpoint, or config doctrine.
---

<section
  id="eligibility-precheck"
  class="bg-white border border-gray-200 rounded-2xl shadow-sm p-6 sm:p-8 my-10"
  aria-label="480-a Eligibility Pre-Check"
>
  <!-- Header -->
  <div class="mb-7">
    <p class="text-xs font-bold uppercase tracking-widest text-[#2d5a2d] mb-1">
      Free Screening Tool
    </p>
    <h2 class="text-xl sm:text-2xl font-bold text-[#1a3c1a] leading-tight">
      480-a Eligibility Pre-Check
    </h2>
    <p class="text-gray-600 text-sm mt-2 leading-relaxed">
      Answer 6 quick questions to find out whether your property may be a good fit for a
      480-a consultation with Henry. This takes about 60 seconds.
    </p>
  </div>

  <!-- Form -->
  <form id="precheck-form" novalidate>
    <div class="space-y-6" id="precheck-fields">

      <!-- Q1: County -->
      <fieldset class="precheck-field">
        <legend class="block text-sm font-semibold text-gray-800 mb-2">
          1. What county is your property in?
        </legend>
        <select
          name="county"
          id="county"
          class="w-full sm:w-80 border border-gray-300 rounded-lg px-4 py-2.5 text-sm text-gray-800 bg-white focus:outline-none focus:ring-2 focus:ring-[#2d5a2d] focus:border-transparent"
          required
        >
          <option value="">— Select a county —</option>
          <option value="sullivan">Sullivan County, NY</option>
          <option value="orange">Orange County, NY</option>
          <option value="ulster">Ulster County, NY</option>
          <option value="dutchess">Dutchess County, NY</option>
          <option value="putnam">Putnam County, NY</option>
          <option value="greene">Greene County, NY</option>
          <option value="delaware">Delaware County, NY</option>
          <option value="westchester">Westchester County, NY</option>
          <option value="rockland">Rockland County, NY</option>
          <option value="other-ny">Other New York County</option>
          <option value="not-ny">Not in New York</option>
        </select>
      </fieldset>

      <!-- Q2: Acreage -->
      <fieldset class="precheck-field">
        <legend class="block text-sm font-semibold text-gray-800 mb-3">
          2. Approximately how many wooded acres do you have?
        </legend>
        <div class="flex flex-wrap gap-2">
          {[
            { value: "under25",  label: "Under 25 acres" },
            { value: "25to49",   label: "25–49 acres" },
            { value: "50to99",   label: "50–99 acres" },
            { value: "100plus",  label: "100+ acres" },
            { value: "not-sure", label: "Not sure" },
          ].map(opt => (
            <label class="precheck-chip">
              <input type="radio" name="acreage" value={opt.value} class="sr-only" />
              <span>{opt.label}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <!-- Q3: Contiguous -->
      <fieldset class="precheck-field">
        <legend class="block text-sm font-semibold text-gray-800 mb-3">
          3. Is the wooded acreage mostly contiguous (connected in one block)?
        </legend>
        <div class="flex flex-wrap gap-2">
          {[
            { value: "yes",      label: "Yes" },
            { value: "no",       label: "No" },
            { value: "not-sure", label: "Not sure" },
          ].map(opt => (
            <label class="precheck-chip">
              <input type="radio" name="contiguous" value={opt.value} class="sr-only" />
              <span>{opt.label}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <!-- Q4: Goal -->
      <fieldset class="precheck-field">
        <legend class="block text-sm font-semibold text-gray-800 mb-3">
          4. What is your main goal for this property?
        </legend>
        <div class="flex flex-wrap gap-2">
          {[
            { value: "taxes",    label: "Lower my property taxes" },
            { value: "manage",   label: "Manage my woods long-term" },
            { value: "timber",   label: "Sell timber responsibly" },
            { value: "habitat",  label: "Improve wildlife habitat" },
            { value: "not-sure", label: "I'm not sure yet" },
          ].map(opt => (
            <label class="precheck-chip">
              <input type="radio" name="goal" value={opt.value} class="sr-only" />
              <span>{opt.label}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <!-- Q5: Management plan -->
      <fieldset class="precheck-field">
        <legend class="block text-sm font-semibold text-gray-800 mb-3">
          5. Do you already have a forest management plan prepared by a forester?
        </legend>
        <div class="flex flex-wrap gap-2">
          {[
            { value: "yes",      label: "Yes" },
            { value: "no",       label: "No" },
            { value: "not-sure", label: "Not sure" },
          ].map(opt => (
            <label class="precheck-chip">
              <input type="radio" name="plan", value={opt.value} class="sr-only" />
              <span>{opt.label}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <!-- Q6: In NY -->
      <fieldset class="precheck-field">
        <legend class="block text-sm font-semibold text-gray-800 mb-3">
          6. Is your property located in New York State?
        </legend>
        <div class="flex flex-wrap gap-2">
          {[
            { value: "yes", label: "Yes" },
            { value: "no",  label: "No" },
          ].map(opt => (
            <label class="precheck-chip">
              <input type="radio" name="inNY" value={opt.value} class="sr-only" />
              <span>{opt.label}</span>
            </label>
          ))}
        </div>
      </fieldset>

    </div>

    <!-- Submit -->
    <div class="mt-8">
      <p id="precheck-error" class="text-red-600 text-sm mb-3 hidden" aria-live="polite">
        Please answer all questions before checking eligibility.
      </p>
      <button
        type="submit"
        id="precheck-submit"
        class="inline-flex items-center gap-2 bg-[#2d5a2d] hover:bg-[#1a3c1a] text-white font-semibold text-sm px-7 py-3 rounded-lg transition-colors shadow-sm"
      >
        Check My Eligibility
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </button>
    </div>
  </form>

  <!-- Result panel — hidden until submit -->
  <div id="precheck-result" class="hidden mt-8 pt-8 border-t border-gray-200" aria-live="polite" role="status">
    <!-- Injected by JS -->
  </div>

</section>

<!-- ─── Chip styles ─────────────────────────────────────────────────── -->
<style>
  .precheck-chip span {
    display: inline-block;
    padding: 0.4rem 1rem;
    border-radius: 9999px;
    border: 1.5px solid #d1d5db;
    font-size: 0.875rem;
    color: #374151;
    cursor: pointer;
    transition: background-color 0.12s, border-color 0.12s, color 0.12s;
    user-select: none;
    white-space: nowrap;
  }
  .precheck-chip input:checked + span {
    background-color: #2d5a2d;
    border-color: #2d5a2d;
    color: #ffffff;
    font-weight: 600;
  }
  .precheck-chip:hover span {
    border-color: #2d5a2d;
    color: #1a3c1a;
  }
  .precheck-chip input:focus-visible + span {
    outline: 2px solid #2d5a2d;
    outline-offset: 2px;
  }
</style>

<!-- ─── Logic ────────────────────────────────────────────────────────── -->
<script>
(function () {

  const form    = document.getElementById('precheck-form');
  const result  = document.getElementById('precheck-result');
  const errMsg  = document.getElementById('precheck-error');

  // ── Result content templates ───────────────────────────────────────
  const RESULTS = {
    A: {
      icon: '✅',
      badgeClass: 'bg-green-100 text-green-800 border border-green-200',
      badge: 'Likely Good Candidate',
      headingClass: 'text-[#1a3c1a]',
      heading: 'You may be a strong candidate for a 480-a consultation.',
      body: 'Your property may meet the general profile for landowners who should speak with a consulting forester about New York\'s 480-a Forest Tax Law program. The next step is a site-specific review with Henry — there is no obligation and no cost to find out more.',
      primaryHref: '/contact',
      primaryLabel: 'Request a 480-a Eligibility Review',
      secondaryHref: 'tel:+18457548242',
      secondaryLabel: 'Call (845) 754-8242',
      containerClass: 'bg-green-50 border-green-200',
    },
    B: {
      icon: '🔍',
      badgeClass: 'bg-yellow-100 text-yellow-800 border border-yellow-200',
      badge: 'Needs Closer Review',
      headingClass: 'text-[#1a3c1a]',
      heading: 'You may still qualify, but your property needs a closer review.',
      body: 'Based on your answers, it is not yet clear whether your land is a fit for 480-a. Parcel layout, actual wooded acreage, and site conditions all matter. Henry can review the property and explain your options — including alternatives if 480-a is not the right fit.',
      primaryHref: '/contact',
      primaryLabel: 'Ask Henry to Review My Property',
      secondaryHref: 'tel:+18457548242',
      secondaryLabel: 'Call (845) 754-8242',
      containerClass: 'bg-yellow-50 border-yellow-200',
    },
    C: {
      icon: 'ℹ️',
      badgeClass: 'bg-gray-100 text-gray-700 border border-gray-200',
      badge: 'May Not Be Current Fit',
      headingClass: 'text-[#1a3c1a]',
      heading: '480-a may not be the best fit based on your current answers.',
      body: 'Based on your responses, your property may not meet the typical profile for a 480-a enrollment conversation. You may still benefit from a forestry consultation, woodlot planning, land clearing guidance, or another service depending on your goals.',
      primaryHref: '/services',
      primaryLabel: 'See Other Forestry Services',
      secondaryHref: '/contact',
      secondaryLabel: 'Contact Henry Anyway',
      containerClass: 'bg-gray-50 border-gray-200',
    },
  };

  // ── Eligibility logic ──────────────────────────────────────────────
  function determineResult(data) {
    const { county, acreage, contiguous, goal, plan, inNY } = data;

    // Hard disqualifiers → C
    if (inNY === 'no')       return 'C';
    if (county === 'not-ny') return 'C';
    if (acreage === 'under25') return 'C';

    // Strong qualifying signals → A
    const goodAcreage     = acreage === '50to99' || acreage === '100plus';
    const goodContiguous  = contiguous === 'yes' || contiguous === 'not-sure';
    const compatibleGoal  = ['taxes', 'manage', 'timber', 'habitat'].includes(goal);

    if (goodAcreage && goodContiguous && compatibleGoal) return 'A';

    // Borderline → B
    // 25-49 acres, unsure on contiguous, or multiple not-sures
    return 'B';
  }

  // ── Build result HTML ──────────────────────────────────────────────
  function buildResultHTML(key) {
    const r = RESULTS[key];
    return `
      <div class="rounded-xl border ${r.containerClass} p-6 sm:p-8">
        <div class="flex items-start gap-4">
          <span class="text-2xl flex-shrink-0" aria-hidden="true">${r.icon}</span>
          <div class="flex-1 min-w-0">
            <span class="inline-block text-xs font-semibold px-3 py-1 rounded-full ${r.badgeClass} mb-3">
              ${r.badge}
            </span>
            <h3 class="text-lg sm:text-xl font-bold ${r.headingClass} leading-snug mb-3">
              ${r.heading}
            </h3>
            <p class="text-gray-700 text-sm leading-relaxed mb-6">
              ${r.body}
            </p>
            <div class="flex flex-col sm:flex-row gap-3">
              <a
                href="${r.primaryHref}"
                class="inline-flex items-center justify-center gap-2 bg-[#2d5a2d] hover:bg-[#1a3c1a] text-white font-semibold text-sm px-6 py-3 rounded-lg transition-colors shadow-sm"
              >
                ${r.primaryLabel}
              </a>
              <a
                href="${r.secondaryHref}"
                class="inline-flex items-center justify-center gap-2 text-[#2d5a2d] hover:text-[#1a3c1a] border border-[#2d5a2d] hover:border-[#1a3c1a] font-semibold text-sm px-6 py-3 rounded-lg transition-colors"
              >
                ${r.secondaryLabel}
              </a>
            </div>
          </div>
        </div>
      </div>
      <p class="text-xs text-gray-400 mt-4 leading-relaxed">
        <strong>Disclaimer:</strong> This tool is a preliminary screening guide only. It is not legal or tax advice.
        Final eligibility for the 480-a Forest Tax Law program depends on a property-specific review by a
        certified forester and approval by the NY Department of Environmental Conservation.
      </p>
      <button
        id="precheck-reset"
        class="mt-4 text-xs text-[#2d5a2d] hover:underline focus:outline-none"
        type="button"
      >
        ← Start over
      </button>
    `;
  }

  // ── Validate all 6 questions answered ────────────────────────────
  function collectAnswers() {
    const data = {};
    const required = ['county', 'acreage', 'contiguous', 'goal', 'plan', 'inNY'];

    // county is a <select>
    const countyEl = form.querySelector('[name="county"]');
    data.county = countyEl ? countyEl.value : '';

    // radio groups
    ['acreage', 'contiguous', 'goal', 'plan', 'inNY'].forEach(name => {
      const checked = form.querySelector(`[name="${name}"]:checked`);
      data[name] = checked ? checked.value : '';
    });

    const allAnswered = required.every(k => data[k] !== '');
    return { data, allAnswered };
  }

  // ── Submit handler ────────────────────────────────────────────────
  form.addEventListener('submit', function (e) {
    e.preventDefault();
    const { data, allAnswered } = collectAnswers();

    if (!allAnswered) {
      errMsg.classList.remove('hidden');
      errMsg.focus();
      return;
    }

    errMsg.classList.add('hidden');

    const key = determineResult(data);
    result.innerHTML = buildResultHTML(key);
    result.classList.remove('hidden');

    // Smooth scroll to result
    result.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

    // Reset handler
    document.getElementById('precheck-reset')?.addEventListener('click', function () {
      form.reset();
      // Deselect all chips visually
      form.querySelectorAll('input[type="radio"]').forEach(r => r.checked = false);
      result.classList.add('hidden');
      result.innerHTML = '';
      errMsg.classList.add('hidden');
      form.querySelector('[name="county"]').focus();
    });
  });

})();
</script>
