---
// CTASection.astro
// High-contrast CTA band at the bottom of every page — no exceptions.
// Phone number large and prominent. Secondary form link below.
// variant: 'b2c' (default) | 'b2b'

import { business, cta } from '../../data/client.config';

interface Props {
  variant?: 'b2c' | 'b2b';
  heading?: string;
}

const { variant = 'b2c', heading } = Astro.props;
const activeCta = cta[variant];

const defaultHeading = variant === 'b2b'
  ? "Ready to discuss your project?"
  : "Ready to protect your woodland investment?";

const defaultSubtext = variant === 'b2b'
  ? `Henry Kowalec is a certified consulting forester with ${business.ownerExperience} of experience. Commercial quotes available.`
  : `Free consultation for landowners in Sullivan, Orange, and Ulster counties. No obligation — just straight answers from a certified forester.`;
---

<section class="bg-[#1a3c1a] py-16 sm:py-20 mt-16">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">

    <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-white mb-4 leading-tight">
      {heading ?? defaultHeading}
    </h2>

    <p class="text-green-200 text-base sm:text-lg mb-10 max-w-xl mx-auto leading-relaxed">
      {defaultSubtext}
    </p>

    <!-- Primary CTA — phone, large -->
    <a
      href={activeCta.primary.href}
      class="inline-flex items-center gap-3 bg-white text-[#1a3c1a] hover:bg-green-50 font-bold text-xl sm:text-2xl px-8 py-5 rounded-lg shadow-xl transition-colors mb-5 w-full sm:w-auto justify-center"
    >
      <svg class="w-6 h-6 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
        <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
      </svg>
      {business.phone}
    </a>

    <p class="text-green-300 text-sm mb-6 block">{activeCta.primary.label}</p>

    <!-- Secondary CTA — form link -->
    <div>
      <a
        href={activeCta.secondary.href}
        class="inline-flex items-center gap-2 text-green-300 hover:text-white border border-green-600 hover:border-green-400 text-sm font-medium px-6 py-3 rounded transition-colors"
      >
        {activeCta.secondary.label}
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

    <p class="mt-8 text-green-700 text-xs">
      {business.name} · {business.address.city}, {business.address.stateAbbr}
    </p>

  </div>
</section>
