---
// Breadcrumb.astro
// Visual breadcrumb trail — same crumbs array must also feed BreadcrumbList schema.
// ONE source array. TWO outputs: this component (visual) + schema component (JSON-LD).
// Never define breadcrumb data separately for visual and schema.

import type { Crumb } from '../../data/schema/breadcrumbs';

interface Props {
  crumbs: Crumb[];
}
const { crumbs } = Astro.props;
---

{crumbs.length > 1 && (
  <nav aria-label="Breadcrumb" class="py-3 px-4 sm:px-0">
    <ol class="flex flex-wrap items-center gap-1 text-sm text-gray-500">
      {crumbs.map((crumb, index) => {
        const isLast = index === crumbs.length - 1;
        return (
          <li class="flex items-center gap-1">
            {!isLast ? (
              <>
                <a
                  href={crumb.href}
                  class="hover:text-[#2d5a2d] transition-colors"
                >
                  {crumb.label}
                </a>
                <svg class="w-3.5 h-3.5 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </>
            ) : (
              <span class="text-gray-800 font-medium" aria-current="page">
                {crumb.label}
              </span>
            )}
          </li>
        );
      })}
    </ol>
  </nav>
)}
