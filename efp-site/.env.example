# ============================================================
# EFP — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in real values.
# NEVER commit .env to git. .env is in .gitignore.
# ============================================================

# Google Analytics 4
PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# CRST Web CRM
# ⚠️ Do NOT reference GoHighLevel by name in any deliverable, UI string, or comment.
# Use "CRST Web" in all client-facing and team-facing materials.
PUBLIC_GHL_LOCATION_ID=
PUBLIC_GHL_API_BASE=https://rest.gohighlevel.com
PUBLIC_TRACKING_SCRIPT_ID=

# DataForSEO — keyword research and entity extraction
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ============================================================
# FUTURE USE ONLY — do not implement until explicitly requested
# Uncomment and fill in only when ecommerce is scoped and approved
# ============================================================
# STRIPE_SECRET_KEY=
# PUBLIC_STRIPE_PAYMENT_LINK=
